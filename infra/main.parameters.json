{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": { "value": "${AZURE_ENV_NAME}" },
    "location": { "value": "${AZURE_LOCATION}" },
    "subscriptionId": { "value": "${AZURE_SUBSCRIPTION_ID}" },
    "tenantId": { "value": "${AZURE_TENANT_ID}" },
    "resourceGroupName": { "value": "${SUPPLY_RESPONSE_RESOURCE_GROUP}" },
    "containerAppName": { "value": "${SUPPLY_RESPONSE_CONTAINER_APP_NAME}" },
    "sharedResourceGroupName": { "value": "${SUPPLY_RESPONSE_SHARED_RESOURCE_GROUP}" },
    "sharedContainerAppsEnvironmentName": { "value": "${SUPPLY_RESPONSE_SHARED_CONTAINER_APPS_ENVIRONMENT}" },
    "sharedRegistryName": { "value": "${SUPPLY_RESPONSE_SHARED_REGISTRY}" },
    "sharedLogAnalyticsWorkspaceName": { "value": "${SUPPLY_RESPONSE_SHARED_LOG_ANALYTICS_WORKSPACE}" },
    "minReplicas": { "value": "${SUPPLY_RESPONSE_MIN_REPLICAS=0}" },
    "bootstrapMode": { "value": "${SUPPLY_RESPONSE_BOOTSTRAP_MODE=true}" },
    "imageName": { "value": "${SUPPLY_RESPONSE_IMAGE_NAME=}" },
    "foundryProjectResourceId": { "value": "${SUPPLY_RESPONSE_FOUNDRY_PROJECT_RESOURCE_ID}" },
    "apiClientId": { "value": "${SUPPLY_RESPONSE_API_CLIENT_ID}" },
    "alexObjectId": { "value": "${SUPPLY_RESPONSE_ALEX_OBJECT_ID}" },
    "fabricSqlServer": { "value": "${SUPPLY_RESPONSE_FABRIC_SQL_SERVER}" },
    "fabricSqlDatabase": { "value": "${SUPPLY_RESPONSE_FABRIC_SQL_DATABASE}" },
    "workIqSupplierSourceId": { "value": "${SUPPLY_RESPONSE_WORKIQ_SUPPLIER_SOURCE_ID}" },
    "workIqQualitySourceId": { "value": "${SUPPLY_RESPONSE_WORKIQ_QUALITY_SOURCE_ID}" },
    "workIqSupplierSender": { "value": "${SUPPLY_RESPONSE_WORKIQ_SUPPLIER_SENDER}" },
    "workIqQualityAuthorObjectId": { "value": "${SUPPLY_RESPONSE_WORKIQ_QUALITY_AUTHOR_OBJECT_ID}" },
    "workIqTeamId": { "value": "${SUPPLY_RESPONSE_WORKIQ_TEAM_ID}" },
    "workIqChannelId": { "value": "${SUPPLY_RESPONSE_WORKIQ_CHANNEL_ID}" },
    "workIqCorpusVersion": { "value": "${SUPPLY_RESPONSE_WORKIQ_CORPUS_VERSION}" },
    "workIqDeploymentReceipt": { "value": "${SUPPLY_RESPONSE_WORKIQ_DEPLOYMENT_RECEIPT}" },
    "tenantSharePointHost": { "value": "${SUPPLY_RESPONSE_TENANT_SHAREPOINT_HOST}" },
    "foundryProjectEndpoint": { "value": "${SUPPLY_RESPONSE_FOUNDRY_PROJECT_ENDPOINT}" },
    "foundrySignalAgentName": { "value": "${SUPPLY_RESPONSE_FOUNDRY_SIGNAL_AGENT_NAME}" },
    "foundrySignalAgentVersion": { "value": "${SUPPLY_RESPONSE_FOUNDRY_SIGNAL_AGENT_VERSION}" },
    "foundryContextAgentName": { "value": "${SUPPLY_RESPONSE_FOUNDRY_CONTEXT_AGENT_NAME}" },
    "foundryContextAgentVersion": { "value": "${SUPPLY_RESPONSE_FOUNDRY_CONTEXT_AGENT_VERSION}" },
    "foundryDecisionAgentName": { "value": "${SUPPLY_RESPONSE_FOUNDRY_DECISION_AGENT_NAME}" },
    "foundryDecisionAgentVersion": { "value": "${SUPPLY_RESPONSE_FOUNDRY_DECISION_AGENT_VERSION}" },
    "foundryDeploymentReceipt": { "value": "${SUPPLY_RESPONSE_FOUNDRY_DEPLOYMENT_RECEIPT}" },
    "powerBiReportUrl": { "value": "${SUPPLY_RESPONSE_POWER_BI_REPORT_URL}" },
    "powerBiDeploymentReceipt": { "value": "${SUPPLY_RESPONSE_POWER_BI_DEPLOYMENT_RECEIPT}" },
    "powerBiReportingReceipt": { "value": "${SUPPLY_RESPONSE_POWER_BI_REPORTING_RECEIPT}" },
    "fabricCitationBaseUrl": { "value": "${SUPPLY_RESPONSE_FABRIC_CITATION_BASE_URL}" }
  }
}
