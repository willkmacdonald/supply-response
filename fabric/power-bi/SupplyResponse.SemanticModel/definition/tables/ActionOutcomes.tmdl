table ActionOutcomes
  column case_id
    dataType: string
    sourceColumn: case_id
    summarizeBy: none

  column decision_id
    dataType: string
    sourceColumn: decision_id
    summarizeBy: none

  column selected_option_id
    dataType: string
    sourceColumn: selected_option_id
    summarizeBy: none

  column record_type
    dataType: string
    sourceColumn: record_type
    summarizeBy: none

  column action_id
    dataType: string
    sourceColumn: action_id
    summarizeBy: none

  column action_kind
    dataType: string
    sourceColumn: action_kind
    summarizeBy: none

  column action_status
    dataType: string
    sourceColumn: action_status
    summarizeBy: none

  column metric
    dataType: string
    sourceColumn: metric
    summarizeBy: none

  column predicted_value
    dataType: string
    sourceColumn: predicted_value
    summarizeBy: none

  column observed_value
    dataType: string
    sourceColumn: observed_value
    summarizeBy: none

  column unit
    dataType: string
    sourceColumn: unit
    summarizeBy: none

  column observation_kind
    dataType: string
    sourceColumn: observation_kind
    summarizeBy: none

  column scenario_effective_time
    dataType: dateTime
    formatString: General Date
    sourceColumn: scenario_effective_time
    summarizeBy: none

  column projection_updated_at
    dataType: dateTime
    formatString: General Date
    sourceColumn: projection_updated_at
    summarizeBy: none

  measure 'Action Completion %' =
      VAR DecisionId = [Current Decision ID]
      VAR Actions = FILTER(ALL(ActionOutcomes), ActionOutcomes[decision_id] = DecisionId && ActionOutcomes[record_type] = "action")
      RETURN DIVIDE(COUNTROWS(FILTER(Actions, ActionOutcomes[action_status] = "completed")), COUNTROWS(Actions))
    formatString: 0%;-0%;0%

  measure 'Current Action Status' =
      VAR DecisionId = [Current Decision ID]
      VAR ActionKind = SELECTEDVALUE(ActionOutcomes[action_kind])
      RETURN CALCULATE(SELECTEDVALUE(ActionOutcomes[action_status]), REMOVEFILTERS(ActionOutcomes), ActionOutcomes[decision_id] = DecisionId, ActionOutcomes[record_type] = "action", ActionOutcomes[action_kind] = ActionKind)

  measure 'Current Observation Kind' =
      VAR DecisionId = [Current Decision ID]
      RETURN CALCULATE(SELECTEDVALUE(ActionOutcomes[observation_kind]), REMOVEFILTERS(ActionOutcomes), ActionOutcomes[decision_id] = DecisionId, ActionOutcomes[record_type] = "observation")

  measure 'Observed Variance' =
      VAR DecisionId = [Current Decision ID]
      VAR RecordType = SELECTEDVALUE(ActionOutcomes[record_type])
      VAR MetricName = SELECTEDVALUE(ActionOutcomes[metric])
      VAR SupportedMetric =
          MetricName IN {
              "alpha_expedited_quantity",
              "dallas_transfer_quantity",
              "total_response_arranged_supply",
              "uncovered_part_demand",
              "response_cost",
              "protected_customer_orders",
              "revenue_protected",
              "margin_protected",
              "otif_loss_percentage"
          }
      VAR PredictedText = CALCULATE(SELECTEDVALUE(ActionOutcomes[predicted_value]), ActionOutcomes[decision_id] = DecisionId)
      VAR ObservedText = CALCULATE(SELECTEDVALUE(ActionOutcomes[observed_value]), ActionOutcomes[decision_id] = DecisionId)
      VAR Predicted = IFERROR(VALUE(PredictedText), BLANK())
      VAR Observed = IFERROR(VALUE(ObservedText), BLANK())
      RETURN
          IF(
              RecordType <> "observation"
                  || NOT SupportedMetric
                  || ISBLANK(Predicted)
                  || ISBLANK(Observed)
                  || Predicted = 0,
              BLANK(),
              DIVIDE(Observed - Predicted, ABS(Predicted))
          )
    formatString: 0.00%;-0.00%;0.00%

  measure 'Projection Refresh Time' =
      VAR DecisionId = [Current Decision ID]
      RETURN CALCULATE(MAX(ActionOutcomes[projection_updated_at]), REMOVEFILTERS(ActionOutcomes), ActionOutcomes[decision_id] = DecisionId)
    formatString: General Date

  measure 'Action Scenario Effective Time' =
      VAR DecisionId = [Current Decision ID]
      RETURN CALCULATE(MAX(ActionOutcomes[scenario_effective_time]), REMOVEFILTERS(ActionOutcomes), ActionOutcomes[decision_id] = DecisionId)
    formatString: General Date

  partition ActionOutcomes = m
    mode: directQuery
    source =
        Sql.Database(
          FABRIC_SQL_SERVER,
          FABRIC_SQL_DATABASE,
          [Query="SELECT * FROM analytics.action_outcomes"]
        )
