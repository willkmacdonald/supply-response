table ActionOutcomes
  column case_id
    dataType: string
    sourceColumn: case_id
    summarizeBy: none

  column decision_id
    dataType: string
    sourceColumn: decision_id
    summarizeBy: none

  column selected_option_id
    dataType: string
    sourceColumn: selected_option_id
    summarizeBy: none

  column record_type
    dataType: string
    sourceColumn: record_type
    summarizeBy: none

  column action_id
    dataType: string
    sourceColumn: action_id
    summarizeBy: none

  column action_kind
    dataType: string
    sourceColumn: action_kind
    summarizeBy: none

  column action_status
    dataType: string
    sourceColumn: action_status
    summarizeBy: none

  column metric
    dataType: string
    sourceColumn: metric
    summarizeBy: none

  column predicted_value
    dataType: string
    sourceColumn: predicted_value
    summarizeBy: none

  column observed_value
    dataType: string
    sourceColumn: observed_value
    summarizeBy: none

  column unit
    dataType: string
    sourceColumn: unit
    summarizeBy: none

  column observation_kind
    dataType: string
    sourceColumn: observation_kind
    summarizeBy: none

  column scenario_effective_time
    dataType: dateTime
    sourceColumn: scenario_effective_time
    summarizeBy: none
    formatString: MMM d, yyyy HH:mm "UTC"

  column projection_updated_at
    dataType: dateTime
    sourceColumn: projection_updated_at
    summarizeBy: none
    formatString: MMM d, yyyy HH:mm "UTC"

  column case_key
    dataType: string
    sourceColumn: case_key
    summarizeBy: none

  column decision_key
    dataType: string
    sourceColumn: decision_key
    summarizeBy: none

  column action_key
    dataType: string
    sourceColumn: action_key
    summarizeBy: none

  measure 'Observed Variance' =
      IF([Observation Row Visible] == 1,(VAR ScopeCase = [Selected Case Key]
      VAR ScopeAnalysis = [Current Decision Key]
      RETURN IF(NOT ISBLANK(ScopeCase) && NOT ISBLANK(ScopeAnalysis), CALCULATE(VAR PredictedText = SELECTEDVALUE(ActionOutcomes[predicted_value])
              VAR ObservedText = SELECTEDVALUE(ActionOutcomes[observed_value])
              VAR Predicted = IFERROR(VALUE(PredictedText), BLANK())
              VAR Observed = IFERROR(VALUE(ObservedText), BLANK())
              RETURN IF(ISBLANK(Predicted) || ISBLANK(Observed) || Predicted == 0,BLANK(),
                  DIVIDE(Observed - Predicted, ABS(Predicted))), KEEPFILTERS(TREATAS({ScopeCase}, ActionOutcomes[case_key])), KEEPFILTERS(TREATAS({ScopeAnalysis}, ActionOutcomes[decision_key])), KEEPFILTERS(ActionOutcomes[record_type] == "observation")))))
    formatString: 0.00%;-0.00%;0.00%

  partition ActionOutcomes = m
    mode: directQuery
    source =
        Sql.Database(FABRIC_SQL_SERVER, FABRIC_SQL_DATABASE, [Query="SELECT a.case_id,a.decision_id,a.selected_option_id,a.record_type,a.action_id,#(lf) a.action_kind,a.action_status,a.metric,a.predicted_value,a.observed_value,#(lf) a.unit,a.observation_kind,#(lf) CONVERT(datetime2(6),SWITCHOFFSET(a.scenario_effective_time,'+00:00')) AS scenario_effective_time,#(lf) CONVERT(datetime2(6),SWITCHOFFSET(a.projection_updated_at,'+00:00')) AS projection_updated_at,#(lf) CONVERT(varchar(max),CONVERT(varbinary(max),CONVERT(nvarchar(max),a.case_id)),2) AS case_key,#(lf) CONVERT(varchar(max),CONVERT(varbinary(max),CONVERT(nvarchar(max),a.decision_id)),2) AS decision_key,#(lf) CONVERT(varchar(max),CONVERT(varbinary(max),CONVERT(nvarchar(max),a.action_id)),2) AS action_key#(lf)FROM analytics.action_outcomes a#(lf)"])
