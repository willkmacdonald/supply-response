table CaseCommandCenter
  column case_id
    dataType: string
    sourceColumn: case_id
    summarizeBy: none

  column purpose
    dataType: string
    sourceColumn: purpose
    summarizeBy: none

  column status
    dataType: string
    sourceColumn: status
    summarizeBy: none

  column runtime_mode
    dataType: string
    sourceColumn: runtime_mode
    summarizeBy: none

  column walkthrough_route
    dataType: string
    sourceColumn: walkthrough_route
    summarizeBy: none

  column scenario_effective_time
    dataType: dateTime
    sourceColumn: scenario_effective_time
    summarizeBy: none
    formatString: MMM d, yyyy HH:mm "UTC"

  column current_analysis_id
    dataType: string
    sourceColumn: current_analysis_id
    summarizeBy: none

  column current_decision_id
    dataType: string
    sourceColumn: current_decision_id
    summarizeBy: none

  column analysis_created_at
    dataType: dateTime
    sourceColumn: analysis_created_at
    summarizeBy: none
    formatString: MMM d, yyyy HH:mm "UTC"

  column snapshot_state
    dataType: string
    sourceColumn: snapshot_state
    summarizeBy: none

  column recommended_option_id
    dataType: string
    sourceColumn: recommended_option_id
    summarizeBy: none

  column baseline_option_id
    dataType: string
    sourceColumn: baseline_option_id
    summarizeBy: none

  column decision_kind
    dataType: string
    sourceColumn: decision_kind
    summarizeBy: none

  column decision_analysis_id
    dataType: string
    sourceColumn: decision_analysis_id
    summarizeBy: none

  column decided_at
    dataType: dateTime
    sourceColumn: decided_at
    summarizeBy: none
    formatString: MMM d, yyyy HH:mm "UTC"

  column approved_option_id
    dataType: string
    sourceColumn: approved_option_id
    summarizeBy: none

  column baseline_revenue_at_risk
    dataType: decimal
    sourceColumn: baseline_revenue_at_risk
    summarizeBy: none
    formatString: #,0.00

  column baseline_otif_loss_percentage
    dataType: int64
    sourceColumn: baseline_otif_loss_percentage
    summarizeBy: none
    formatString: 0"%"

  column baseline_uncovered_part_demand
    dataType: int64
    sourceColumn: baseline_uncovered_part_demand
    summarizeBy: none
    formatString: #,0

  column baseline_response_cost
    dataType: decimal
    sourceColumn: baseline_response_cost
    summarizeBy: none
    formatString: #,0.00

  column recommended_revenue_at_risk
    dataType: decimal
    sourceColumn: recommended_revenue_at_risk
    summarizeBy: none
    formatString: #,0.00

  column recommended_otif_loss_percentage
    dataType: int64
    sourceColumn: recommended_otif_loss_percentage
    summarizeBy: none
    formatString: 0"%"

  column recommended_uncovered_part_demand
    dataType: int64
    sourceColumn: recommended_uncovered_part_demand
    summarizeBy: none
    formatString: #,0

  column recommended_response_cost
    dataType: decimal
    sourceColumn: recommended_response_cost
    summarizeBy: none
    formatString: #,0.00

  column approved_revenue_at_risk
    dataType: decimal
    sourceColumn: approved_revenue_at_risk
    summarizeBy: none
    formatString: #,0.00

  column approved_otif_loss_percentage
    dataType: int64
    sourceColumn: approved_otif_loss_percentage
    summarizeBy: none
    formatString: 0"%"

  column approved_uncovered_part_demand
    dataType: int64
    sourceColumn: approved_uncovered_part_demand
    summarizeBy: none
    formatString: #,0

  column approved_response_cost
    dataType: decimal
    sourceColumn: approved_response_cost
    summarizeBy: none
    formatString: #,0.00

  column case_key
    dataType: string
    sourceColumn: case_key
    summarizeBy: none

  column current_analysis_key
    dataType: string
    sourceColumn: current_analysis_key
    summarizeBy: none

  column current_decision_key
    dataType: string
    sourceColumn: current_decision_key
    summarizeBy: none

  column decision_analysis_key
    dataType: string
    sourceColumn: decision_analysis_key
    summarizeBy: none

  column approved_option_key
    dataType: string
    sourceColumn: approved_option_key
    summarizeBy: none

  measure 'External Walkthrough Requested' =
      INT(ISFILTERED(CaseCommandCenter[walkthrough_route]))
    isHidden

  measure 'Walkthrough Requested' =
      CALCULATE([External Walkthrough Requested], ALLSELECTED(CaseCommandCenter))
    isHidden

  measure 'External Traditional Mode' =
      INT(ISFILTERED(CaseCommandCenter[walkthrough_route])
              && HASONEFILTER(CaseCommandCenter[walkthrough_route])
              && SELECTEDVALUE(CaseCommandCenter[walkthrough_route]) == "traditional")
    isHidden

  measure 'Traditional Mode' =
      CALCULATE([External Traditional Mode], ALLSELECTED(CaseCommandCenter))
    isHidden

  measure 'Review Approach' =
      IF([Walkthrough Requested] == 1,
              IF([Traditional Mode] == 1,
                  "Compare cost, service exposure, parts still needed, and planning blockers. State your proposed response before opening Review with AI assistance.",
                  "Walkthrough selection unavailable"),
              [Recommendation Answer])

  measure 'External Case Requested' =
      INT(ISFILTERED(CaseCommandCenter[case_key]) || ISFILTERED(CaseCommandCenter[case_id]))
    isHidden

  measure 'Case Requested' =
      CALCULATE([External Case Requested], ALLSELECTED(CaseCommandCenter))
    isHidden

  measure 'External Selected Case Key' =
      IF(
              (ISFILTERED(CaseCommandCenter[case_key]) || ISFILTERED(CaseCommandCenter[case_id]))
              && (NOT ISFILTERED(CaseCommandCenter[case_key]) || HASONEFILTER(CaseCommandCenter[case_key]))
              && (NOT ISFILTERED(CaseCommandCenter[case_id]) || HASONEFILTER(CaseCommandCenter[case_id]))
              && COUNTROWS(CaseCommandCenter) == 1,
              SELECTEDVALUE(CaseCommandCenter[case_key]))
    isHidden

  measure 'Selected Case Key' =
      CALCULATE([External Selected Case Key], ALLSELECTED(CaseCommandCenter))
    isHidden

  measure 'External Analysis Requested' =
      INT(ISFILTERED(SavedAnalyses[analysis_key]))
    isHidden

  measure 'Analysis Requested' =
      CALCULATE([External Analysis Requested], ALLSELECTED(SavedAnalyses))
    isHidden

  measure 'External Selected Analysis Key' =
      VAR ScopeCase = [Selected Case Key]
              VAR N = CALCULATE(COUNTROWS(SavedAnalyses), KEEPFILTERS(TREATAS({ScopeCase},SavedAnalyses[case_key])),
                  KEEPFILTERS(SavedAnalyses[payload_state] == "available"),
                  KEEPFILTERS(SavedAnalyses[snapshot_state] == "available"))
              RETURN IF(NOT ISBLANK(ScopeCase) && ISFILTERED(SavedAnalyses[analysis_key])
              && HASONEFILTER(SavedAnalyses[analysis_key]) && N == 1,
              SELECTEDVALUE(SavedAnalyses[analysis_key]))
    isHidden

  measure 'Selected Analysis Key' =
      CALCULATE([External Selected Analysis Key], ALLSELECTED(SavedAnalyses))
    isHidden

  measure 'Case Current Analysis Key' =
      IF(NOT ISBLANK([Selected Case Key]), CALCULATE(SELECTEDVALUE(CaseCommandCenter[current_analysis_key]), ALLSELECTED(CaseCommandCenter)))
    isHidden

  measure 'Current Decision Key' =
      IF(NOT ISBLANK([Selected Case Key]), CALCULATE(SELECTEDVALUE(CaseCommandCenter[current_decision_key]), ALLSELECTED(CaseCommandCenter)))
    isHidden

  measure 'Decision Analysis Key' =
      IF(NOT ISBLANK([Selected Case Key]), CALCULATE(SELECTEDVALUE(CaseCommandCenter[decision_analysis_key]), ALLSELECTED(CaseCommandCenter)))
    isHidden

  measure 'Approved Option Key' =
      IF(NOT ISBLANK([Selected Case Key]), CALCULATE(SELECTEDVALUE(CaseCommandCenter[approved_option_key]), ALLSELECTED(CaseCommandCenter)))
    isHidden

  measure 'Current Decision ID' =
      IF(NOT ISBLANK([Selected Case Key]), CALCULATE(SELECTEDVALUE(CaseCommandCenter[current_decision_id]), ALLSELECTED(CaseCommandCenter)))
    isHidden

  measure 'Case Status' =
      IF(NOT ISBLANK([Selected Case Key]), CALCULATE(SELECTEDVALUE(CaseCommandCenter[status]), ALLSELECTED(CaseCommandCenter)))
    isHidden

  measure 'Decision Kind' =
      IF(NOT ISBLANK([Selected Case Key]), CALCULATE(SELECTEDVALUE(CaseCommandCenter[decision_kind]), ALLSELECTED(CaseCommandCenter)))
    isHidden

  measure 'Case Runtime' =
      IF(NOT ISBLANK([Selected Case Key]), CALCULATE(SELECTEDVALUE(CaseCommandCenter[runtime_mode]), ALLSELECTED(CaseCommandCenter)))
    isHidden

  measure 'Case Display ID' =
      IF(NOT ISBLANK([Selected Case Key]), CALCULATE(SELECTEDVALUE(CaseCommandCenter[case_id]), ALLSELECTED(CaseCommandCenter)))
    isHidden

  measure 'Overview Analysis Key' =
      VAR ScopeCase = [Selected Case Key]
              VAR ScopeAnalysis = [Case Current Analysis Key]
              VAR N = CALCULATE(COUNTROWS(SavedAnalyses), REMOVEFILTERS(SavedAnalyses),
                  TREATAS({ScopeCase},SavedAnalyses[case_key]),TREATAS({ScopeAnalysis},SavedAnalyses[analysis_key]),
                  SavedAnalyses[payload_state] == "available",SavedAnalyses[snapshot_state] == "available")
              RETURN IF([Walkthrough Requested] == 1 || [Analysis Requested] == 1,
                  [Selected Analysis Key],
                  IF(NOT ISBLANK(ScopeCase) && NOT ISBLANK(ScopeAnalysis) && N == 1,ScopeAnalysis))
    isHidden

  measure 'Selected analysis_id' =
      VAR ScopeCase = [Selected Case Key]
      VAR ScopeAnalysis = [Selected Analysis Key]
      RETURN IF(NOT ISBLANK(ScopeCase) && NOT ISBLANK(ScopeAnalysis), CALCULATE(SELECTEDVALUE(SavedAnalyses[analysis_id]), REMOVEFILTERS(SavedAnalyses), KEEPFILTERS(TREATAS({ScopeCase}, SavedAnalyses[case_key])), KEEPFILTERS(TREATAS({ScopeAnalysis}, SavedAnalyses[analysis_key]))))
    isHidden

  measure 'Selected analysis_created_at' =
      VAR ScopeCase = [Selected Case Key]
      VAR ScopeAnalysis = [Selected Analysis Key]
      RETURN IF(NOT ISBLANK(ScopeCase) && NOT ISBLANK(ScopeAnalysis), CALCULATE(SELECTEDVALUE(SavedAnalyses[analysis_created_at]), REMOVEFILTERS(SavedAnalyses), KEEPFILTERS(TREATAS({ScopeCase}, SavedAnalyses[case_key])), KEEPFILTERS(TREATAS({ScopeAnalysis}, SavedAnalyses[analysis_key]))))
    isHidden

  measure 'Selected scenario_effective_time' =
      VAR ScopeCase = [Selected Case Key]
      VAR ScopeAnalysis = [Selected Analysis Key]
      RETURN IF(NOT ISBLANK(ScopeCase) && NOT ISBLANK(ScopeAnalysis), CALCULATE(SELECTEDVALUE(SavedAnalyses[scenario_effective_time]), REMOVEFILTERS(SavedAnalyses), KEEPFILTERS(TREATAS({ScopeCase}, SavedAnalyses[case_key])), KEEPFILTERS(TREATAS({ScopeAnalysis}, SavedAnalyses[analysis_key]))))
    isHidden

  measure 'Selected snapshot_state' =
      VAR ScopeCase = [Selected Case Key]
      VAR ScopeAnalysis = [Selected Analysis Key]
      RETURN IF(NOT ISBLANK(ScopeCase) && NOT ISBLANK(ScopeAnalysis), CALCULATE(SELECTEDVALUE(SavedAnalyses[snapshot_state]), REMOVEFILTERS(SavedAnalyses), KEEPFILTERS(TREATAS({ScopeCase}, SavedAnalyses[case_key])), KEEPFILTERS(TREATAS({ScopeAnalysis}, SavedAnalyses[analysis_key]))))
    isHidden

  measure 'Selected payload_state' =
      VAR ScopeCase = [Selected Case Key]
      VAR ScopeAnalysis = [Selected Analysis Key]
      RETURN IF(NOT ISBLANK(ScopeCase) && NOT ISBLANK(ScopeAnalysis), CALCULATE(SELECTEDVALUE(SavedAnalyses[payload_state]), REMOVEFILTERS(SavedAnalyses), KEEPFILTERS(TREATAS({ScopeCase}, SavedAnalyses[case_key])), KEEPFILTERS(TREATAS({ScopeAnalysis}, SavedAnalyses[analysis_key]))))
    isHidden

  measure 'Selected runtime_mode' =
      VAR ScopeCase = [Selected Case Key]
      VAR ScopeAnalysis = [Selected Analysis Key]
      RETURN IF(NOT ISBLANK(ScopeCase) && NOT ISBLANK(ScopeAnalysis), CALCULATE(SELECTEDVALUE(SavedAnalyses[runtime_mode]), REMOVEFILTERS(SavedAnalyses), KEEPFILTERS(TREATAS({ScopeCase}, SavedAnalyses[case_key])), KEEPFILTERS(TREATAS({ScopeAnalysis}, SavedAnalyses[analysis_key]))))
    isHidden

  measure 'Selected no_feasible_mitigation' =
      VAR ScopeCase = [Selected Case Key]
      VAR ScopeAnalysis = [Selected Analysis Key]
      RETURN IF(NOT ISBLANK(ScopeCase) && NOT ISBLANK(ScopeAnalysis), CALCULATE(SELECTEDVALUE(SavedAnalyses[no_feasible_mitigation]), REMOVEFILTERS(SavedAnalyses), KEEPFILTERS(TREATAS({ScopeCase}, SavedAnalyses[case_key])), KEEPFILTERS(TREATAS({ScopeAnalysis}, SavedAnalyses[analysis_key]))))
    isHidden

  measure 'Selected inventory_complete' =
      VAR ScopeCase = [Selected Case Key]
      VAR ScopeAnalysis = [Selected Analysis Key]
      RETURN IF(NOT ISBLANK(ScopeCase) && NOT ISBLANK(ScopeAnalysis), CALCULATE(SELECTEDVALUE(SavedAnalyses[inventory_complete]), REMOVEFILTERS(SavedAnalyses), KEEPFILTERS(TREATAS({ScopeCase}, SavedAnalyses[case_key])), KEEPFILTERS(TREATAS({ScopeAnalysis}, SavedAnalyses[analysis_key]))))
    isHidden

  measure 'Selected production_orders_complete' =
      VAR ScopeCase = [Selected Case Key]
      VAR ScopeAnalysis = [Selected Analysis Key]
      RETURN IF(NOT ISBLANK(ScopeCase) && NOT ISBLANK(ScopeAnalysis), CALCULATE(SELECTEDVALUE(SavedAnalyses[production_orders_complete]), REMOVEFILTERS(SavedAnalyses), KEEPFILTERS(TREATAS({ScopeCase}, SavedAnalyses[case_key])), KEEPFILTERS(TREATAS({ScopeAnalysis}, SavedAnalyses[analysis_key]))))
    isHidden

  measure 'Selected customer_orders_complete' =
      VAR ScopeCase = [Selected Case Key]
      VAR ScopeAnalysis = [Selected Analysis Key]
      RETURN IF(NOT ISBLANK(ScopeCase) && NOT ISBLANK(ScopeAnalysis), CALCULATE(SELECTEDVALUE(SavedAnalyses[customer_orders_complete]), REMOVEFILTERS(SavedAnalyses), KEEPFILTERS(TREATAS({ScopeCase}, SavedAnalyses[case_key])), KEEPFILTERS(TREATAS({ScopeAnalysis}, SavedAnalyses[analysis_key]))))
    isHidden

  measure 'Overview analysis_id' =
      VAR ScopeCase = [Selected Case Key]
      VAR ScopeAnalysis = [Overview Analysis Key]
      RETURN IF(NOT ISBLANK(ScopeCase) && NOT ISBLANK(ScopeAnalysis), CALCULATE(SELECTEDVALUE(SavedAnalyses[analysis_id]), REMOVEFILTERS(SavedAnalyses), KEEPFILTERS(TREATAS({ScopeCase}, SavedAnalyses[case_key])), KEEPFILTERS(TREATAS({ScopeAnalysis}, SavedAnalyses[analysis_key]))))
    isHidden

  measure 'Overview analysis_created_at' =
      VAR ScopeCase = [Selected Case Key]
      VAR ScopeAnalysis = [Overview Analysis Key]
      RETURN IF(NOT ISBLANK(ScopeCase) && NOT ISBLANK(ScopeAnalysis), CALCULATE(SELECTEDVALUE(SavedAnalyses[analysis_created_at]), REMOVEFILTERS(SavedAnalyses), KEEPFILTERS(TREATAS({ScopeCase}, SavedAnalyses[case_key])), KEEPFILTERS(TREATAS({ScopeAnalysis}, SavedAnalyses[analysis_key]))))
    isHidden

  measure 'Overview scenario_effective_time' =
      VAR ScopeCase = [Selected Case Key]
      VAR ScopeAnalysis = [Overview Analysis Key]
      RETURN IF(NOT ISBLANK(ScopeCase) && NOT ISBLANK(ScopeAnalysis), CALCULATE(SELECTEDVALUE(SavedAnalyses[scenario_effective_time]), REMOVEFILTERS(SavedAnalyses), KEEPFILTERS(TREATAS({ScopeCase}, SavedAnalyses[case_key])), KEEPFILTERS(TREATAS({ScopeAnalysis}, SavedAnalyses[analysis_key]))))
    isHidden

  measure 'Overview snapshot_state' =
      VAR ScopeCase = [Selected Case Key]
      VAR ScopeAnalysis = [Overview Analysis Key]
      RETURN IF(NOT ISBLANK(ScopeCase) && NOT ISBLANK(ScopeAnalysis), CALCULATE(SELECTEDVALUE(SavedAnalyses[snapshot_state]), REMOVEFILTERS(SavedAnalyses), KEEPFILTERS(TREATAS({ScopeCase}, SavedAnalyses[case_key])), KEEPFILTERS(TREATAS({ScopeAnalysis}, SavedAnalyses[analysis_key]))))
    isHidden

  measure 'Overview payload_state' =
      VAR ScopeCase = [Selected Case Key]
      VAR ScopeAnalysis = [Overview Analysis Key]
      RETURN IF(NOT ISBLANK(ScopeCase) && NOT ISBLANK(ScopeAnalysis), CALCULATE(SELECTEDVALUE(SavedAnalyses[payload_state]), REMOVEFILTERS(SavedAnalyses), KEEPFILTERS(TREATAS({ScopeCase}, SavedAnalyses[case_key])), KEEPFILTERS(TREATAS({ScopeAnalysis}, SavedAnalyses[analysis_key]))))
    isHidden

  measure 'Overview runtime_mode' =
      VAR ScopeCase = [Selected Case Key]
      VAR ScopeAnalysis = [Overview Analysis Key]
      RETURN IF(NOT ISBLANK(ScopeCase) && NOT ISBLANK(ScopeAnalysis), CALCULATE(SELECTEDVALUE(SavedAnalyses[runtime_mode]), REMOVEFILTERS(SavedAnalyses), KEEPFILTERS(TREATAS({ScopeCase}, SavedAnalyses[case_key])), KEEPFILTERS(TREATAS({ScopeAnalysis}, SavedAnalyses[analysis_key]))))
    isHidden

  measure 'Overview no_feasible_mitigation' =
      VAR ScopeCase = [Selected Case Key]
      VAR ScopeAnalysis = [Overview Analysis Key]
      RETURN IF(NOT ISBLANK(ScopeCase) && NOT ISBLANK(ScopeAnalysis), CALCULATE(SELECTEDVALUE(SavedAnalyses[no_feasible_mitigation]), REMOVEFILTERS(SavedAnalyses), KEEPFILTERS(TREATAS({ScopeCase}, SavedAnalyses[case_key])), KEEPFILTERS(TREATAS({ScopeAnalysis}, SavedAnalyses[analysis_key]))))
    isHidden

  measure 'Overview inventory_complete' =
      VAR ScopeCase = [Selected Case Key]
      VAR ScopeAnalysis = [Overview Analysis Key]
      RETURN IF(NOT ISBLANK(ScopeCase) && NOT ISBLANK(ScopeAnalysis), CALCULATE(SELECTEDVALUE(SavedAnalyses[inventory_complete]), REMOVEFILTERS(SavedAnalyses), KEEPFILTERS(TREATAS({ScopeCase}, SavedAnalyses[case_key])), KEEPFILTERS(TREATAS({ScopeAnalysis}, SavedAnalyses[analysis_key]))))
    isHidden

  measure 'Overview production_orders_complete' =
      VAR ScopeCase = [Selected Case Key]
      VAR ScopeAnalysis = [Overview Analysis Key]
      RETURN IF(NOT ISBLANK(ScopeCase) && NOT ISBLANK(ScopeAnalysis), CALCULATE(SELECTEDVALUE(SavedAnalyses[production_orders_complete]), REMOVEFILTERS(SavedAnalyses), KEEPFILTERS(TREATAS({ScopeCase}, SavedAnalyses[case_key])), KEEPFILTERS(TREATAS({ScopeAnalysis}, SavedAnalyses[analysis_key]))))
    isHidden

  measure 'Overview customer_orders_complete' =
      VAR ScopeCase = [Selected Case Key]
      VAR ScopeAnalysis = [Overview Analysis Key]
      RETURN IF(NOT ISBLANK(ScopeCase) && NOT ISBLANK(ScopeAnalysis), CALCULATE(SELECTEDVALUE(SavedAnalyses[customer_orders_complete]), REMOVEFILTERS(SavedAnalyses), KEEPFILTERS(TREATAS({ScopeCase}, SavedAnalyses[case_key])), KEEPFILTERS(TREATAS({ScopeAnalysis}, SavedAnalyses[analysis_key]))))
    isHidden

  measure 'Case Selection State' =
      IF([Case Requested] == 0,"Select a case",IF(ISBLANK([Selected Case Key]),"Case selection unavailable — unknown, multiple or conflicting selections","Case " & [Case Display ID]))

  measure 'Overview State' =
      SWITCH(TRUE(),ISBLANK([Selected Case Key]),[Case Selection State],
              [Analysis Requested] == 1 && ISBLANK([Selected Analysis Key]),"This analysis is unavailable in the report",
              ISBLANK([Case Current Analysis Key]) && [Analysis Requested] == 0,"Not analyzed yet",
              ISBLANK([Overview Analysis Key]),"Saved analysis or operational snapshot unavailable",
              [Overview payload_state] <> "available","Saved analysis unavailable",
              "Case " & [Case Display ID] & " · Analysis " & [Overview analysis_id] & " · " & [Overview Provenance])

  measure 'Selected Provenance' =
      VAR V = [Selected runtime_mode] RETURN IF(ISBLANK([Selected analysis_id]),BLANK(),SWITCH(V,"fallback","Saved demo fixture · fictional","live","Saved analysis from live-service mode · fictional scenario · no new retrieval","Saved analysis · source mode unavailable"))
    isHidden

  measure 'Overview Provenance' =
      VAR V = [Overview runtime_mode] RETURN IF(ISBLANK([Overview analysis_id]),BLANK(),SWITCH(V,"fallback","Saved demo fixture · fictional","live","Saved analysis from live-service mode · fictional scenario · no new retrieval","Saved analysis · source mode unavailable"))
    isHidden

  measure 'Scenario Context' =
      VAR V = [Overview scenario_effective_time]
              RETURN IF(NOT ISBLANK([Selected Case Key]),IF(ISBLANK(V),"Scenario time unavailable",
              "In this scenario, as of " & FORMAT(V,"MMM d, yyyy HH:mm") & " UTC"))

  measure 'Snapshot Context' =
      VAR V = [Selected analysis_created_at]
              RETURN IF(NOT ISBLANK([Selected Analysis Key]),
              "Snapshot used for this analysis · " & IF(ISBLANK(V),"Analysis time unavailable",
              FORMAT(V,"MMM d, yyyy HH:mm") & " UTC") & " · " & [Selected Provenance])

  measure 'External Explicit Selected Record Key' =
      VAR ScopeCase = [Selected Case Key] VAR ScopeAnalysis = [Selected Analysis Key]
              VAR N = CALCULATE(COUNTROWS(SavedRecords),
                  KEEPFILTERS(TREATAS({ScopeCase},SavedRecords[case_key])),
                  KEEPFILTERS(TREATAS({ScopeAnalysis},SavedRecords[analysis_key])),
                  KEEPFILTERS(SavedRecords[record_state] == "available"),
                  KEEPFILTERS(SavedRecords[evidence_state] == "available"))
              RETURN IF(NOT ISBLANK(ScopeCase) && NOT ISBLANK(ScopeAnalysis)
                  && ISFILTERED(SavedRecords[record_key]) && HASONEFILTER(SavedRecords[record_key])
                  && ISFILTERED(SavedRecords[record_family]) && HASONEFILTER(SavedRecords[record_family])
                  && SELECTEDVALUE(SavedRecords[record_family]) IN {"shipment","transfer","qualification"}
                  && N == 1,SELECTEDVALUE(SavedRecords[record_key]))
    isHidden

  measure 'Explicit Selected Record Key' =
      CALCULATE([External Explicit Selected Record Key], ALLSELECTED(SavedRecords))
    isHidden

  measure 'External Record Identity Requested' =
      INT(ISFILTERED(SavedRecords[record_key])
              || ISFILTERED(SavedRecords[source_record_id]))
    isHidden

  measure 'Record Identity Requested' =
      CALCULATE([External Record Identity Requested], ALLSELECTED(SavedRecords))
    isHidden

  measure 'External Walkthrough Record Key' =
      VAR CaseKey = [Selected Case Key]
              VAR AnalysisKey = [Selected Analysis Key]
              VAR Family = SELECTEDVALUE(SavedRecords[record_family])
              VAR Candidates = CALCULATETABLE(SavedRecords,
                  REMOVEFILTERS(SavedRecords),
                  TREATAS({CaseKey}, SavedRecords[case_key]),
                  TREATAS({AnalysisKey}, SavedRecords[analysis_key]),
                  TREATAS({Family}, SavedRecords[record_family]))
              VAR ValidCandidates = FILTER(Candidates,
                  SavedRecords[record_state] == "available"
                  && SavedRecords[evidence_state] == "available"
                  && SavedRecords[runtime_mode] == "live"
                  && SavedRecords[provenance] == "saved_fabric")
              RETURN IF([Traditional Mode] == 1
                  && [Record Identity Requested] == 0
                  && NOT ISBLANK(CaseKey) && NOT ISBLANK(AnalysisKey)
                  && ISFILTERED(SavedRecords[record_family])
                  && HASONEFILTER(SavedRecords[record_family])
                  && Family IN {"shipment","transfer","qualification"}
                  && COUNTROWS(Candidates) == 1 && COUNTROWS(ValidCandidates) == 1,
                  MAXX(ValidCandidates, SavedRecords[record_key]))
    isHidden

  measure 'Walkthrough Record Key' =
      CALCULATE([External Walkthrough Record Key], ALLSELECTED(SavedRecords))
    isHidden

  measure 'Selected Record Key' =
      IF([Record Identity Requested] == 1,
              [Explicit Selected Record Key],
              [Walkthrough Record Key])
    isHidden

  measure 'External Selected Record Family' =
      IF(NOT ISBLANK([Selected Record Key]), SELECTEDVALUE(SavedRecords[record_family]))
    isHidden

  measure 'Selected Record Family' =
      CALCULATE([External Selected Record Family], ALLSELECTED(SavedRecords))
    isHidden

  measure 'Record quantity' =
      IF(NOT ISBLANK([Selected Record Key]), (VAR ScopeCase = [Selected Case Key]
      VAR ScopeAnalysis = [Selected Analysis Key]
      RETURN IF(NOT ISBLANK(ScopeCase) && NOT ISBLANK(ScopeAnalysis), CALCULATE(SELECTEDVALUE(SavedRecords[quantity]), REMOVEFILTERS(SavedRecords), KEEPFILTERS(TREATAS({ScopeCase}, SavedRecords[case_key])), KEEPFILTERS(TREATAS({ScopeAnalysis}, SavedRecords[analysis_key])), KEEPFILTERS(TREATAS({[Selected Record Key]}, SavedRecords[record_key])), KEEPFILTERS(TREATAS({[Selected Record Family]}, SavedRecords[record_family])), KEEPFILTERS(SavedRecords[record_state] == "available"), KEEPFILTERS(SavedRecords[evidence_state] == "available")))))
    isHidden

  measure 'Record due_date' =
      IF(NOT ISBLANK([Selected Record Key]), (VAR ScopeCase = [Selected Case Key]
      VAR ScopeAnalysis = [Selected Analysis Key]
      RETURN IF(NOT ISBLANK(ScopeCase) && NOT ISBLANK(ScopeAnalysis), CALCULATE(SELECTEDVALUE(SavedRecords[due_date]), REMOVEFILTERS(SavedRecords), KEEPFILTERS(TREATAS({ScopeCase}, SavedRecords[case_key])), KEEPFILTERS(TREATAS({ScopeAnalysis}, SavedRecords[analysis_key])), KEEPFILTERS(TREATAS({[Selected Record Key]}, SavedRecords[record_key])), KEEPFILTERS(TREATAS({[Selected Record Family]}, SavedRecords[record_family])), KEEPFILTERS(SavedRecords[record_state] == "available"), KEEPFILTERS(SavedRecords[evidence_state] == "available")))))
    isHidden

  measure 'Record arrival_date' =
      IF(NOT ISBLANK([Selected Record Key]), (VAR ScopeCase = [Selected Case Key]
      VAR ScopeAnalysis = [Selected Analysis Key]
      RETURN IF(NOT ISBLANK(ScopeCase) && NOT ISBLANK(ScopeAnalysis), CALCULATE(SELECTEDVALUE(SavedRecords[arrival_date]), REMOVEFILTERS(SavedRecords), KEEPFILTERS(TREATAS({ScopeCase}, SavedRecords[case_key])), KEEPFILTERS(TREATAS({ScopeAnalysis}, SavedRecords[analysis_key])), KEEPFILTERS(TREATAS({[Selected Record Key]}, SavedRecords[record_key])), KEEPFILTERS(TREATAS({[Selected Record Family]}, SavedRecords[record_family])), KEEPFILTERS(SavedRecords[record_state] == "available"), KEEPFILTERS(SavedRecords[evidence_state] == "available")))))
    isHidden

  measure 'Record incremental_cost_per_unit' =
      IF(NOT ISBLANK([Selected Record Key]), (VAR ScopeCase = [Selected Case Key]
      VAR ScopeAnalysis = [Selected Analysis Key]
      RETURN IF(NOT ISBLANK(ScopeCase) && NOT ISBLANK(ScopeAnalysis), CALCULATE(SELECTEDVALUE(SavedRecords[incremental_cost_per_unit]), REMOVEFILTERS(SavedRecords), KEEPFILTERS(TREATAS({ScopeCase}, SavedRecords[case_key])), KEEPFILTERS(TREATAS({ScopeAnalysis}, SavedRecords[analysis_key])), KEEPFILTERS(TREATAS({[Selected Record Key]}, SavedRecords[record_key])), KEEPFILTERS(TREATAS({[Selected Record Family]}, SavedRecords[record_family])), KEEPFILTERS(SavedRecords[record_state] == "available"), KEEPFILTERS(SavedRecords[evidence_state] == "available")))))
