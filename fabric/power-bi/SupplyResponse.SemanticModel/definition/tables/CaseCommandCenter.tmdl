    isHidden

  measure 'Stock State' =
      IF(ISBLANK([Selected Case Key]),[Case Selection State],IF(ISBLANK([Selected Analysis Key]),"Select an available saved analysis",IF(ISBLANK([Stock Count]) || [Stock Count] == 0,"Supporting records unavailable",[Snapshot Context])))

  measure 'Orders Rows Valid' =
      IF([Selected production_orders_complete] == TRUE() && [Selected customer_orders_complete] == TRUE(),(VAR ScopeCase = [Selected Case Key]
      VAR ScopeAnalysis = [Selected Analysis Key]
      RETURN IF(NOT ISBLANK(ScopeCase) && NOT ISBLANK(ScopeAnalysis), CALCULATE(IF(COUNTROWS(SavedRecords)>0 && COALESCE(COUNTROWS(FILTER(SavedRecords,SavedRecords[record_state] <> "available")),0) == 0,1,0), REMOVEFILTERS(SavedRecords), KEEPFILTERS(TREATAS({ScopeCase}, SavedRecords[case_key])), KEEPFILTERS(TREATAS({ScopeAnalysis}, SavedRecords[analysis_key])), KEEPFILTERS(SavedRecords[record_family] == "customer_order_line")))),0)
