  measure 'Stock Held' =
      IF([Stock Rows Valid] == 1,(VAR ScopeCase = [Selected Case Key]
      VAR ScopeAnalysis = [Selected Analysis Key]
      RETURN IF(NOT ISBLANK(ScopeCase) && NOT ISBLANK(ScopeAnalysis), CALCULATE(IF(COUNTROWS(SavedRecords) > 0 && COUNTBLANK(SavedRecords[quality_hold]) == 0, SUM(SavedRecords[quality_hold])), REMOVEFILTERS(SavedRecords), KEEPFILTERS(TREATAS({ScopeCase}, SavedRecords[case_key])), KEEPFILTERS(TREATAS({ScopeAnalysis}, SavedRecords[analysis_key])), KEEPFILTERS(SavedRecords[record_family] == "inventory"), KEEPFILTERS(SavedRecords[in_disruption_scope] == TRUE()), KEEPFILTERS(SavedRecords[record_state] == "available")))))
