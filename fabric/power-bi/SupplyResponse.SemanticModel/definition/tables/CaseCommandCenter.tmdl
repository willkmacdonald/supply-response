      VAR ScopeAnalysis = [Selected Analysis Key]
      RETURN IF(NOT ISBLANK(ScopeCase) && NOT ISBLANK(ScopeAnalysis), CALCULATE(IF(COUNTROWS(SavedRecords) > 0 && COUNTBLANK(SavedRecords[protected_allocation]) == 0, SUM(SavedRecords[protected_allocation])), REMOVEFILTERS(SavedRecords), KEEPFILTERS(TREATAS({ScopeCase}, SavedRecords[case_key])), KEEPFILTERS(TREATAS({ScopeAnalysis}, SavedRecords[analysis_key])), KEEPFILTERS(SavedRecords[record_family] == "inventory"), KEEPFILTERS(SavedRecords[in_disruption_scope] == TRUE()), KEEPFILTERS(SavedRecords[record_state] == "available")))))
    isHidden

  measure 'Stock Protected Display' =
      VAR V = [Stock Protected] RETURN IF(ISBLANK(V), "Unavailable", FORMAT(V, "#,0.##") & " component units")

  measure 'Affected Revenue' =
      IF([Orders Rows Valid] == 1,(VAR ScopeCase = [Selected Case Key]
      VAR ScopeAnalysis = [Selected Analysis Key]
      RETURN IF(NOT ISBLANK(ScopeCase) && NOT ISBLANK(ScopeAnalysis), CALCULATE(IF(COUNTROWS(SavedRecords) > 0 && COUNTBLANK(SavedRecords[line_revenue]) == 0, SUM(SavedRecords[line_revenue])), REMOVEFILTERS(SavedRecords), KEEPFILTERS(TREATAS({ScopeCase}, SavedRecords[case_key])), KEEPFILTERS(TREATAS({ScopeAnalysis}, SavedRecords[analysis_key])), KEEPFILTERS(SavedRecords[record_family] == "customer_order_line"), KEEPFILTERS(SavedRecords[in_disruption_scope] == TRUE()), KEEPFILTERS(SavedRecords[record_state] == "available")))))
    isHidden

  measure 'Affected Revenue Display' =
      VAR V = [Affected Revenue] RETURN IF(ISBLANK(V), "Unavailable", FORMAT(V, "#,0.##") & "; currency not specified")

  measure 'Affected Lines Display' =
      VAR V = [Orders Count] RETURN IF(ISBLANK(V), "Unavailable", FORMAT(V, "#,0") & " saved customer order lines")

  measure 'Stock On Hand Row' =
      IF([Stock Rows Valid] == 1,(VAR ScopeCase = [Selected Case Key]
      VAR ScopeAnalysis = [Selected Analysis Key]
      RETURN IF(NOT ISBLANK(ScopeCase) && NOT ISBLANK(ScopeAnalysis), CALCULATE(IF(COUNTROWS(SavedRecords)>0 && COUNTBLANK(SavedRecords[on_hand]) == 0,SUM(SavedRecords[on_hand])), KEEPFILTERS(TREATAS({ScopeCase}, SavedRecords[case_key])), KEEPFILTERS(TREATAS({ScopeAnalysis}, SavedRecords[analysis_key])), KEEPFILTERS(SavedRecords[record_family] == "inventory"), KEEPFILTERS(SavedRecords[in_disruption_scope] == TRUE()), KEEPFILTERS(SavedRecords[record_state] == "available")))))
    formatString: #,0

  measure 'Stock Held Row' =
      IF([Stock Rows Valid] == 1,(VAR ScopeCase = [Selected Case Key]
      VAR ScopeAnalysis = [Selected Analysis Key]
      RETURN IF(NOT ISBLANK(ScopeCase) && NOT ISBLANK(ScopeAnalysis), CALCULATE(IF(COUNTROWS(SavedRecords)>0 && COUNTBLANK(SavedRecords[quality_hold]) == 0,SUM(SavedRecords[quality_hold])), KEEPFILTERS(TREATAS({ScopeCase}, SavedRecords[case_key])), KEEPFILTERS(TREATAS({ScopeAnalysis}, SavedRecords[analysis_key])), KEEPFILTERS(SavedRecords[record_family] == "inventory"), KEEPFILTERS(SavedRecords[in_disruption_scope] == TRUE()), KEEPFILTERS(SavedRecords[record_state] == "available")))))
    formatString: #,0

  measure 'Stock Protected Row' =
      IF([Stock Rows Valid] == 1,(VAR ScopeCase = [Selected Case Key]
      VAR ScopeAnalysis = [Selected Analysis Key]
      RETURN IF(NOT ISBLANK(ScopeCase) && NOT ISBLANK(ScopeAnalysis), CALCULATE(IF(COUNTROWS(SavedRecords)>0 && COUNTBLANK(SavedRecords[protected_allocation]) == 0,SUM(SavedRecords[protected_allocation])), KEEPFILTERS(TREATAS({ScopeCase}, SavedRecords[case_key])), KEEPFILTERS(TREATAS({ScopeAnalysis}, SavedRecords[analysis_key])), KEEPFILTERS(SavedRecords[record_family] == "inventory"), KEEPFILTERS(SavedRecords[in_disruption_scope] == TRUE()), KEEPFILTERS(SavedRecords[record_state] == "available")))))
    formatString: #,0

  measure 'Stock Usable Row' =
      IF([Stock Rows Valid] == 1,(VAR ScopeCase = [Selected Case Key]
      VAR ScopeAnalysis = [Selected Analysis Key]
      RETURN IF(NOT ISBLANK(ScopeCase) && NOT ISBLANK(ScopeAnalysis), CALCULATE(IF(COUNTROWS(SavedRecords)>0 && COUNTBLANK(SavedRecords[usable_inventory]) == 0,SUM(SavedRecords[usable_inventory])), KEEPFILTERS(TREATAS({ScopeCase}, SavedRecords[case_key])), KEEPFILTERS(TREATAS({ScopeAnalysis}, SavedRecords[analysis_key])), KEEPFILTERS(SavedRecords[record_family] == "inventory"), KEEPFILTERS(SavedRecords[in_disruption_scope] == TRUE()), KEEPFILTERS(SavedRecords[record_state] == "available")))))
    formatString: #,0

  measure 'Stock Explanation' =
      IF(NOT ISBLANK([Selected Analysis Key]),"Usable component stock = on hand − quality holds − protected allocations, for the disruption’s exact part and plant.")

  measure 'Orders Basis Display' =
      IF(NOT ISBLANK([Selected Analysis Key]),"Customer order lines in this analysis")

  measure 'Orders Baseline Revenue' =
      IF(NOT ISBLANK([Selected Analysis Key]),[Baseline revenue_at_risk])
    isHidden

  measure 'Orders Baseline OTIF' =
      IF(NOT ISBLANK([Selected Analysis Key]),[Baseline otif_loss_percentage])
    isHidden

  measure 'Orders Baseline Revenue Display' =
      VAR V = [Orders Baseline Revenue] RETURN IF(ISBLANK(V), "Unavailable", FORMAT(V, "#,0.##") & "; currency not specified")

  measure 'Orders Baseline OTIF Display' =
      VAR V = [Orders Baseline OTIF] RETURN IF(ISBLANK(V), "Unavailable", FORMAT(V, "0") & "%")

  measure 'Orders Explanation' =
      IF(NOT ISBLANK([Selected Analysis Key]),"Without a response, the analysis predicts the exposure above. The supporting rows are customer order lines in scope; their line values are not predicted revenue at risk, and these rows do not identify individual missed service targets.")

  measure 'External Option Requested' =
      INT(ISFILTERED(SavedOptions[option_key]))
    isHidden

  measure 'Option Requested' =
      CALCULATE([External Option Requested], ALLSELECTED(SavedOptions))
    isHidden

  measure 'External Selected Option Key' =
      VAR ScopeCase = [Selected Case Key] VAR ScopeAnalysis = [Selected Analysis Key]
              VAR N = CALCULATE(COUNTROWS(SavedOptions),KEEPFILTERS(TREATAS({ScopeCase},SavedOptions[case_key])),
                  KEEPFILTERS(TREATAS({ScopeAnalysis},SavedOptions[analysis_key])))
              RETURN IF(NOT ISBLANK(ScopeCase) && NOT ISBLANK(ScopeAnalysis) && ISFILTERED(SavedOptions[option_key])
                  && HASONEFILTER(SavedOptions[option_key]) && N == 1,SELECTEDVALUE(SavedOptions[option_key]))
    isHidden

  measure 'Selected Option Key' =
      CALCULATE([External Selected Option Key], ALLSELECTED(SavedOptions))
    isHidden

  measure 'Option Row Visible' =
      IF([Option Requested] == 0 || NOT ISBLANK([Selected Option Key]),INT((VAR ScopeCase = [Selected Case Key]
      VAR ScopeAnalysis = [Selected Analysis Key]
      RETURN IF(NOT ISBLANK(ScopeCase) && NOT ISBLANK(ScopeAnalysis), CALCULATE(COUNTROWS(SavedOptions), KEEPFILTERS(TREATAS({ScopeCase}, SavedOptions[case_key])), KEEPFILTERS(TREATAS({ScopeAnalysis}, SavedOptions[analysis_key]))))) > 0),0)
    isHidden

  measure 'Option Revenue' =
      IF([Option Row Visible] == 1,(VAR ScopeCase = [Selected Case Key]
      VAR ScopeAnalysis = [Selected Analysis Key]
      RETURN IF(NOT ISBLANK(ScopeCase) && NOT ISBLANK(ScopeAnalysis), CALCULATE(IF(COUNTROWS(SavedOptions) == 1,SELECTEDVALUE(SavedOptions[revenue_at_risk])), KEEPFILTERS(TREATAS({ScopeCase}, SavedOptions[case_key])), KEEPFILTERS(TREATAS({ScopeAnalysis}, SavedOptions[analysis_key]))))))
    formatString: #,0.00

  measure 'Option Response Cost' =
      IF([Option Row Visible] == 1,(VAR ScopeCase = [Selected Case Key]
      VAR ScopeAnalysis = [Selected Analysis Key]
      RETURN IF(NOT ISBLANK(ScopeCase) && NOT ISBLANK(ScopeAnalysis), CALCULATE(IF(COUNTROWS(SavedOptions) == 1,SELECTEDVALUE(SavedOptions[response_cost])), KEEPFILTERS(TREATAS({ScopeCase}, SavedOptions[case_key])), KEEPFILTERS(TREATAS({ScopeAnalysis}, SavedOptions[analysis_key]))))))
    formatString: #,0.00

  measure 'Selected Option option_display_name' =
      IF(NOT ISBLANK([Selected Option Key]),(VAR ScopeCase = [Selected Case Key]
      VAR ScopeAnalysis = [Selected Analysis Key]
      RETURN IF(NOT ISBLANK(ScopeCase) && NOT ISBLANK(ScopeAnalysis), CALCULATE(IF(COUNTROWS(SavedOptions) == 1,CONCATENATEX(SavedOptions,SavedOptions[option_display_name],"")), REMOVEFILTERS(SavedOptions), KEEPFILTERS(TREATAS({ScopeCase}, SavedOptions[case_key])), KEEPFILTERS(TREATAS({ScopeAnalysis}, SavedOptions[analysis_key])), KEEPFILTERS(TREATAS({[Selected Option Key]}, SavedOptions[option_key]))))))
    isHidden

  measure 'Selected Option revenue_at_risk' =
