      VAR ScopeCase = [Selected Case Key]
      VAR ScopeAnalysis = [Overview Analysis Key]
      RETURN IF(NOT ISBLANK(ScopeCase) && NOT ISBLANK(ScopeAnalysis), CALCULATE(IF(COUNTROWS(SavedRecords) == 1,SELECTEDVALUE(SavedRecords[incremental_cost_per_unit])), REMOVEFILTERS(SavedRecords), KEEPFILTERS(TREATAS({ScopeCase}, SavedRecords[case_key])), KEEPFILTERS(TREATAS({ScopeAnalysis}, SavedRecords[analysis_key])), KEEPFILTERS(SavedRecords[record_family] == "shipment"), KEEPFILTERS(SavedRecords[record_state] == "available"), KEEPFILTERS(SavedRecords[evidence_state] == "available")))
    isHidden

  measure 'Overview shipment supplier_id' =
      VAR ScopeCase = [Selected Case Key]
      VAR ScopeAnalysis = [Overview Analysis Key]
      RETURN IF(NOT ISBLANK(ScopeCase) && NOT ISBLANK(ScopeAnalysis), CALCULATE(IF(COUNTROWS(SavedRecords) == 1,SELECTEDVALUE(SavedRecords[supplier_id])), REMOVEFILTERS(SavedRecords), KEEPFILTERS(TREATAS({ScopeCase}, SavedRecords[case_key])), KEEPFILTERS(TREATAS({ScopeAnalysis}, SavedRecords[analysis_key])), KEEPFILTERS(SavedRecords[record_family] == "shipment"), KEEPFILTERS(SavedRecords[record_state] == "available"), KEEPFILTERS(SavedRecords[evidence_state] == "available")))
    isHidden

  measure 'Overview transfer quantity' =
      VAR ScopeCase = [Selected Case Key]
      VAR ScopeAnalysis = [Overview Analysis Key]
      RETURN IF(NOT ISBLANK(ScopeCase) && NOT ISBLANK(ScopeAnalysis), CALCULATE(IF(COUNTROWS(SavedRecords) == 1,SELECTEDVALUE(SavedRecords[quantity])), REMOVEFILTERS(SavedRecords), KEEPFILTERS(TREATAS({ScopeCase}, SavedRecords[case_key])), KEEPFILTERS(TREATAS({ScopeAnalysis}, SavedRecords[analysis_key])), KEEPFILTERS(SavedRecords[record_family] == "transfer"), KEEPFILTERS(SavedRecords[record_state] == "available"), KEEPFILTERS(SavedRecords[evidence_state] == "available")))
    isHidden

  measure 'Overview transfer arrival_date' =
      VAR ScopeCase = [Selected Case Key]
      VAR ScopeAnalysis = [Overview Analysis Key]
      RETURN IF(NOT ISBLANK(ScopeCase) && NOT ISBLANK(ScopeAnalysis), CALCULATE(IF(COUNTROWS(SavedRecords) == 1,SELECTEDVALUE(SavedRecords[arrival_date])), REMOVEFILTERS(SavedRecords), KEEPFILTERS(TREATAS({ScopeCase}, SavedRecords[case_key])), KEEPFILTERS(TREATAS({ScopeAnalysis}, SavedRecords[analysis_key])), KEEPFILTERS(SavedRecords[record_family] == "transfer"), KEEPFILTERS(SavedRecords[record_state] == "available"), KEEPFILTERS(SavedRecords[evidence_state] == "available")))
    isHidden

  measure 'Overview transfer incremental_cost_per_unit' =
      VAR ScopeCase = [Selected Case Key]
      VAR ScopeAnalysis = [Overview Analysis Key]
      RETURN IF(NOT ISBLANK(ScopeCase) && NOT ISBLANK(ScopeAnalysis), CALCULATE(IF(COUNTROWS(SavedRecords) == 1,SELECTEDVALUE(SavedRecords[incremental_cost_per_unit])), REMOVEFILTERS(SavedRecords), KEEPFILTERS(TREATAS({ScopeCase}, SavedRecords[case_key])), KEEPFILTERS(TREATAS({ScopeAnalysis}, SavedRecords[analysis_key])), KEEPFILTERS(SavedRecords[record_family] == "transfer"), KEEPFILTERS(SavedRecords[record_state] == "available"), KEEPFILTERS(SavedRecords[evidence_state] == "available")))
    isHidden

  measure 'Overview transfer source_plant_id' =
      VAR ScopeCase = [Selected Case Key]
      VAR ScopeAnalysis = [Overview Analysis Key]
      RETURN IF(NOT ISBLANK(ScopeCase) && NOT ISBLANK(ScopeAnalysis), CALCULATE(IF(COUNTROWS(SavedRecords) == 1,SELECTEDVALUE(SavedRecords[source_plant_id])), REMOVEFILTERS(SavedRecords), KEEPFILTERS(TREATAS({ScopeCase}, SavedRecords[case_key])), KEEPFILTERS(TREATAS({ScopeAnalysis}, SavedRecords[analysis_key])), KEEPFILTERS(SavedRecords[record_family] == "transfer"), KEEPFILTERS(SavedRecords[record_state] == "available"), KEEPFILTERS(SavedRecords[evidence_state] == "available")))
    isHidden

  measure 'Overview transfer destination_plant_id' =
      VAR ScopeCase = [Selected Case Key]
      VAR ScopeAnalysis = [Overview Analysis Key]
      RETURN IF(NOT ISBLANK(ScopeCase) && NOT ISBLANK(ScopeAnalysis), CALCULATE(IF(COUNTROWS(SavedRecords) == 1,SELECTEDVALUE(SavedRecords[destination_plant_id])), REMOVEFILTERS(SavedRecords), KEEPFILTERS(TREATAS({ScopeCase}, SavedRecords[case_key])), KEEPFILTERS(TREATAS({ScopeAnalysis}, SavedRecords[analysis_key])), KEEPFILTERS(SavedRecords[record_family] == "transfer"), KEEPFILTERS(SavedRecords[record_state] == "available"), KEEPFILTERS(SavedRecords[evidence_state] == "available")))
    isHidden

  measure 'Overview qualification status' =
      VAR ScopeCase = [Selected Case Key]
      VAR ScopeAnalysis = [Overview Analysis Key]
      RETURN IF(NOT ISBLANK(ScopeCase) && NOT ISBLANK(ScopeAnalysis), CALCULATE(IF(COUNTROWS(SavedRecords) == 1,SELECTEDVALUE(SavedRecords[status])), REMOVEFILTERS(SavedRecords), KEEPFILTERS(TREATAS({ScopeCase}, SavedRecords[case_key])), KEEPFILTERS(TREATAS({ScopeAnalysis}, SavedRecords[analysis_key])), KEEPFILTERS(SavedRecords[record_family] == "qualification"), KEEPFILTERS(SavedRecords[record_state] == "available"), KEEPFILTERS(SavedRecords[evidence_state] == "available")))
    isHidden

  measure 'Overview qualification supplier_id' =
      VAR ScopeCase = [Selected Case Key]
      VAR ScopeAnalysis = [Overview Analysis Key]
      RETURN IF(NOT ISBLANK(ScopeCase) && NOT ISBLANK(ScopeAnalysis), CALCULATE(IF(COUNTROWS(SavedRecords) == 1,SELECTEDVALUE(SavedRecords[supplier_id])), REMOVEFILTERS(SavedRecords), KEEPFILTERS(TREATAS({ScopeCase}, SavedRecords[case_key])), KEEPFILTERS(TREATAS({ScopeAnalysis}, SavedRecords[analysis_key])), KEEPFILTERS(SavedRecords[record_family] == "qualification"), KEEPFILTERS(SavedRecords[record_state] == "available"), KEEPFILTERS(SavedRecords[evidence_state] == "available")))
    isHidden

  measure 'Overview Stock Rows Valid' =
      IF([Overview inventory_complete] == TRUE(),(VAR ScopeCase = [Selected Case Key]
      VAR ScopeAnalysis = [Overview Analysis Key]
      RETURN IF(NOT ISBLANK(ScopeCase) && NOT ISBLANK(ScopeAnalysis), CALCULATE(IF(COUNTROWS(SavedRecords)>0 && COALESCE(COUNTROWS(FILTER(SavedRecords,SavedRecords[record_state] <> "available")),0) == 0,1,0), REMOVEFILTERS(SavedRecords), KEEPFILTERS(TREATAS({ScopeCase}, SavedRecords[case_key])), KEEPFILTERS(TREATAS({ScopeAnalysis}, SavedRecords[analysis_key])), KEEPFILTERS(SavedRecords[record_family] == "inventory")))),0)
    isHidden

  measure 'Overview Stock' =
      IF([Overview Stock Rows Valid] == 1,(VAR ScopeCase = [Selected Case Key]
      VAR ScopeAnalysis = [Overview Analysis Key]
      RETURN IF(NOT ISBLANK(ScopeCase) && NOT ISBLANK(ScopeAnalysis), CALCULATE(IF(COUNTROWS(SavedRecords)>0 && COUNTBLANK(SavedRecords[usable_inventory]) == 0,SUM(SavedRecords[usable_inventory])), REMOVEFILTERS(SavedRecords), KEEPFILTERS(TREATAS({ScopeCase}, SavedRecords[case_key])), KEEPFILTERS(TREATAS({ScopeAnalysis}, SavedRecords[analysis_key])), KEEPFILTERS(SavedRecords[record_family] == "inventory"), KEEPFILTERS(SavedRecords[in_disruption_scope] == TRUE()), KEEPFILTERS(SavedRecords[record_state] == "available")))))
    isHidden

  measure 'Overview disruption Supplier' =
      VAR V = [Overview disruption supplier_id] RETURN IF(ISBLANK(V),"Supplier unavailable",SWITCH(TRUE(),EXACT(V,"RL-SUP-ALPHA"),"RL-Supplier Alpha — Current supplier",EXACT(V,"RL-SUP-BETA"),"RL-Supplier Beta — Alternate supplier","Supplier " & V))
    isHidden

  measure 'Overview shipment Supplier' =
      VAR V = [Overview shipment supplier_id] RETURN IF(ISBLANK(V),"Supplier unavailable",SWITCH(TRUE(),EXACT(V,"RL-SUP-ALPHA"),"RL-Supplier Alpha — Current supplier",EXACT(V,"RL-SUP-BETA"),"RL-Supplier Beta — Alternate supplier","Supplier " & V))
    isHidden

  measure 'Overview qualification Supplier' =
      VAR V = [Overview qualification supplier_id] RETURN IF(ISBLANK(V),"Supplier unavailable",SWITCH(TRUE(),EXACT(V,"RL-SUP-ALPHA"),"RL-Supplier Alpha — Current supplier",EXACT(V,"RL-SUP-BETA"),"RL-Supplier Beta — Alternate supplier","Supplier " & V))
    isHidden

  measure 'Overview Transfer Source' =
      VAR V = [Overview transfer source_plant_id] RETURN IF(ISBLANK(V),"Plant unavailable",SWITCH(TRUE(),EXACT(V,"RL-PLANT-DAL"),"Dallas plant",EXACT(V,"RL-PLANT-CHI"),"Chicago plant","Plant " & V))
    isHidden

  measure 'Overview Transfer Destination' =
      VAR V = [Overview transfer destination_plant_id] RETURN IF(ISBLANK(V),"Plant unavailable",SWITCH(TRUE(),EXACT(V,"RL-PLANT-DAL"),"Dallas plant",EXACT(V,"RL-PLANT-CHI"),"Chicago plant","Plant " & V))
    isHidden

  measure 'Overview Disruption Plant' =
      VAR V = [Overview disruption plant_id] RETURN IF(ISBLANK(V),"Plant unavailable",SWITCH(TRUE(),EXACT(V,"RL-PLANT-DAL"),"Dallas plant",EXACT(V,"RL-PLANT-CHI"),"Chicago plant","Plant " & V))
    isHidden

  measure 'Overview Qualification Status Display' =
      VAR V = [Overview qualification status] RETURN SWITCH(TRUE(),ISBLANK(V),"Qualification unavailable",EXACT(V,"approved"),"Qualification approved",EXACT(V,"pending"),"Not yet qualified — review pending",EXACT(V,"not_approved"),"Qualification not approved",EXACT(V,"conditional"),"Conditional qualification — requirements remain","Qualification status unresolved (" & V & ")")
    isHidden

  measure 'Disruption Answer' =
      VAR Q = [Overview disruption original_quantity]
              RETURN IF(NOT ISBLANK([Overview Analysis Key]),IF(ISBLANK(Q),"Disruption details unavailable",
              "Original delivery: " & FORMAT(Q,"#,0") & " component units of "
              & COALESCE([Overview disruption part_id],"part unavailable") & " were due at "
              & [Overview Disruption Plant] & " on "
              & IF(ISBLANK([Overview disruption original_due_date]),"date unavailable",FORMAT([Overview disruption original_due_date],"MMM d"))
              & ". Disruption reported for " & [Overview disruption Supplier] & "."))

  measure 'Availability Answer' =
      IF(NOT ISBLANK([Overview Analysis Key]),IF(ISBLANK([Overview Stock]),"Available stock unavailable",FORMAT([Overview Stock],"#,0") & " usable component units after holds and protected allocations"))

  measure 'Exposure Answer' =
      VAR V = [Baseline revenue_at_risk] VAR P = [Baseline otif_loss_percentage]
              VAR U = [Baseline uncovered_part_demand] VAR ScopeCase = [Baseline response_cost]
              RETURN IF(NOT ISBLANK([Overview Analysis Key]),"Without a response: "
              & IF(ISBLANK(V),"revenue exposure unavailable",FORMAT(V,"#,0.00") & " revenue at risk; currency not specified")
              & ". Service-target exposure: " & IF(ISBLANK(P),"unavailable",FORMAT(P,"0") & "% of production orders")
              & "; parts still needed: " & IF(ISBLANK(U),"unavailable",FORMAT(U,"#,0") & " component units still needed")
              & "; response cost: " & IF(ISBLANK(ScopeCase),"unavailable",FORMAT(ScopeCase,"#,0.00") & "; currency not specified"))

  measure 'Shipment Answer' =
      VAR Q = [Overview shipment quantity] VAR D = [Overview shipment due_date] VAR Cost = [Overview shipment incremental_cost_per_unit] RETURN IF(NOT ISBLANK([Overview Analysis Key]),IF(ISBLANK(Q),"Supporting record unavailable",("Proposed shipment from " & [Overview shipment Supplier]) & ": " & FORMAT(Q,"#,0") & " component units; " & IF(ISBLANK(D),"date unavailable",FORMAT(D,"MMM d, yyyy")) & "; " & IF(ISBLANK(Cost),"additional cost unavailable","additional cost: " & FORMAT(Cost,"#,0.00") & " per component unit; currency not specified")))

  measure 'Transfer Answer' =
      VAR Q = [Overview transfer quantity] VAR D = [Overview transfer arrival_date] VAR Cost = [Overview transfer incremental_cost_per_unit] RETURN IF(NOT ISBLANK([Overview Analysis Key]),IF(ISBLANK(Q),"Supporting record unavailable",([Overview Transfer Source] & " to " & [Overview Transfer Destination]) & ": " & FORMAT(Q,"#,0") & " component units; " & IF(ISBLANK(D),"date unavailable",FORMAT(D,"MMM d, yyyy")) & "; " & IF(ISBLANK(Cost),"additional cost unavailable","additional cost: " & FORMAT(Cost,"#,0.00") & " per component unit; currency not specified")))

  measure 'Qualification Answer' =
      IF(NOT ISBLANK([Overview Analysis Key]),[Overview qualification Supplier] & ": " & [Overview Qualification Status Display])

  measure 'Options Answer' =
      IF(NOT ISBLANK([Overview Analysis Key]),"Compare the do-nothing option and response options by cost, service exposure, parts still needed, and planning requirements. Predictions are not observed results.")

  measure 'Recommendation Answer' =
      IF(NOT ISBLANK([Overview Analysis Key]),IF([Overview no_feasible_mitigation] == TRUE(),
              "No option meets the planning requirements",
              IF(ISBLANK([Recommended option_display_name]),"Recommendation unavailable",
              [Recommended option_display_name] & "; " & IF(ISBLANK([Recommended uncovered_part_demand]),"parts still needed unavailable",
              FORMAT([Recommended uncovered_part_demand],"#,0") & " component units still needed")
              & "; production-order service-target exposure " & IF(ISBLANK([Recommended otif_loss_percentage]),"unavailable",
              FORMAT([Recommended otif_loss_percentage],"0") & "%")
              & "; revenue at risk " & IF(ISBLANK([Recommended revenue_at_risk]),"unavailable",FORMAT([Recommended revenue_at_risk],"#,0.00"))
              & "; response cost " & IF(ISBLANK([Recommended response_cost]),"unavailable",FORMAT([Recommended response_cost],"#,0.00"))
              & " (currency not specified)"
              & ". Recommendation for this analysis. Current decision is shown separately.")))

  measure 'Decision Answer' =
      IF(NOT ISBLANK([Selected Case Key]),IF(ISBLANK([Current Decision Key]),
              IF([Case Status] == "awaiting_decision","Awaiting approval","No current decision recorded · " & [Case Status]),
              IF([Decision Kind] == "approved","Approved option: " & COALESCE([Approved option_display_name],"Unavailable"),
              "Recorded decision: " & COALESCE([Decision Kind],"Unavailable"))) & ". Approval remains an explicit action in the demo.")

  measure 'Action Row Visible' =
      INT((VAR ScopeCase = [Selected Case Key]
      VAR ScopeAnalysis = [Current Decision Key]
      RETURN IF(NOT ISBLANK(ScopeCase) && NOT ISBLANK(ScopeAnalysis), CALCULATE(COUNTROWS(ActionOutcomes), KEEPFILTERS(TREATAS({ScopeCase}, ActionOutcomes[case_key])), KEEPFILTERS(TREATAS({ScopeAnalysis}, ActionOutcomes[decision_key])), KEEPFILTERS(ActionOutcomes[record_type] == "action")))) > 0)
    isHidden

  measure 'Observation Row Visible' =
      VAR ScopeCase = [Selected Case Key]
      VAR ScopeAnalysis = [Current Decision Key]
      RETURN IF(NOT ISBLANK(ScopeCase) && NOT ISBLANK(ScopeAnalysis), CALCULATE(VAR M = SELECTEDVALUE(ActionOutcomes[metric]) VAR U = SELECTEDVALUE(ActionOutcomes[unit])
              VAR K = SELECTEDVALUE(ActionOutcomes[observation_kind])
              VAR E = SWITCH(M,"alpha_expedited_quantity","units","dallas_transfer_quantity","units","total_response_arranged_supply","units","uncovered_part_demand","units","response_cost","USD","protected_customer_orders","orders","revenue_protected","USD","margin_protected","USD","otif_loss_percentage","percent",BLANK())
              RETURN IF(COUNTROWS(ActionOutcomes)>0 && NOT ISBLANK(M) && NOT ISBLANK(U)
              && NOT ISBLANK(K) && NOT ISBLANK(E) && U == E,1,0), KEEPFILTERS(TREATAS({ScopeCase}, ActionOutcomes[case_key])), KEEPFILTERS(TREATAS({ScopeAnalysis}, ActionOutcomes[decision_key])), KEEPFILTERS(ActionOutcomes[record_type] == "observation")))
    isHidden

  measure 'Current Actions Count' =
      VAR ScopeCase = [Selected Case Key]
      VAR ScopeAnalysis = [Current Decision Key]
      RETURN IF(NOT ISBLANK(ScopeCase) && NOT ISBLANK(ScopeAnalysis), CALCULATE(COUNTROWS(ActionOutcomes), REMOVEFILTERS(ActionOutcomes), KEEPFILTERS(TREATAS({ScopeCase}, ActionOutcomes[case_key])), KEEPFILTERS(TREATAS({ScopeAnalysis}, ActionOutcomes[decision_key])), KEEPFILTERS(ActionOutcomes[record_type] == "action")))
    isHidden

  measure 'Current Observations Count' =
      VAR ScopeCase = [Selected Case Key]
      VAR ScopeAnalysis = [Current Decision Key]
      RETURN IF(NOT ISBLANK(ScopeCase) && NOT ISBLANK(ScopeAnalysis), CALCULATE(COUNTROWS(ActionOutcomes), REMOVEFILTERS(ActionOutcomes), KEEPFILTERS(TREATAS({ScopeCase}, ActionOutcomes[case_key])), KEEPFILTERS(TREATAS({ScopeAnalysis}, ActionOutcomes[decision_key])), KEEPFILTERS(ActionOutcomes[record_type] == "observation")))
    isHidden

  measure 'Current Action Status' =
      VAR ScopeCase = [Selected Case Key]
      VAR ScopeAnalysis = [Current Decision Key]
      RETURN IF(NOT ISBLANK(ScopeCase) && NOT ISBLANK(ScopeAnalysis), CALCULATE(SELECTEDVALUE(ActionOutcomes[action_status]), REMOVEFILTERS(ActionOutcomes), KEEPFILTERS(TREATAS({ScopeCase}, ActionOutcomes[case_key])), KEEPFILTERS(TREATAS({ScopeAnalysis}, ActionOutcomes[decision_key])), KEEPFILTERS(ActionOutcomes[record_type] == "action")))
    isHidden

  measure 'Current Observation Kind' =
      VAR ScopeCase = [Selected Case Key]
      VAR ScopeAnalysis = [Current Decision Key]
      RETURN IF(NOT ISBLANK(ScopeCase) && NOT ISBLANK(ScopeAnalysis), CALCULATE(SELECTEDVALUE(ActionOutcomes[observation_kind]), REMOVEFILTERS(ActionOutcomes), KEEPFILTERS(TREATAS({ScopeCase}, ActionOutcomes[case_key])), KEEPFILTERS(TREATAS({ScopeAnalysis}, ActionOutcomes[decision_key])), KEEPFILTERS(ActionOutcomes[record_type] == "observation")))
    isHidden

  measure 'Projection Refresh Time' =
      VAR ScopeCase = [Selected Case Key]
      VAR ScopeAnalysis = [Current Decision Key]
      RETURN IF(NOT ISBLANK(ScopeCase) && NOT ISBLANK(ScopeAnalysis), CALCULATE(MAX(ActionOutcomes[projection_updated_at]), REMOVEFILTERS(ActionOutcomes), KEEPFILTERS(TREATAS({ScopeCase}, ActionOutcomes[case_key])), KEEPFILTERS(TREATAS({ScopeAnalysis}, ActionOutcomes[decision_key]))))
    isHidden

  measure 'Current Action Status Label' =
      VAR ScopeCase = [Selected Case Key]
      VAR ScopeAnalysis = [Current Decision Key]
      RETURN IF(NOT ISBLANK(ScopeCase) && NOT ISBLANK(ScopeAnalysis), CALCULATE(VAR Labels = DISTINCT(SELECTCOLUMNS(ActionOutcomes,"DisplayValue",ActionOutcomes[action_status_display])) RETURN IF(COUNTROWS(Labels) == 1,CONCATENATEX(Labels,[DisplayValue],"")), REMOVEFILTERS(ActionOutcomes), KEEPFILTERS(TREATAS({ScopeCase}, ActionOutcomes[case_key])), KEEPFILTERS(TREATAS({ScopeAnalysis}, ActionOutcomes[decision_key])), KEEPFILTERS(ActionOutcomes[record_type] == "action")))
    isHidden

  measure 'Current Observation Kind Label' =
      VAR ScopeCase = [Selected Case Key]
      VAR ScopeAnalysis = [Current Decision Key]
      RETURN IF(NOT ISBLANK(ScopeCase) && NOT ISBLANK(ScopeAnalysis), CALCULATE(VAR Labels = DISTINCT(SELECTCOLUMNS(ActionOutcomes,"DisplayValue",ActionOutcomes[observation_kind_display])) RETURN IF(COUNTROWS(Labels) == 1,CONCATENATEX(Labels,[DisplayValue],"")), REMOVEFILTERS(ActionOutcomes), KEEPFILTERS(TREATAS({ScopeCase}, ActionOutcomes[case_key])), KEEPFILTERS(TREATAS({ScopeAnalysis}, ActionOutcomes[decision_key])), KEEPFILTERS(ActionOutcomes[record_type] == "observation")))
    isHidden

  measure 'Current Decision Display' =
      IF(ISBLANK([Selected Case Key]),[Case Selection State],IF(ISBLANK([Current Decision Key]),"No current decision recorded",COALESCE([Decision Kind],"Decision kind unavailable")))

  measure 'Current Action Status Display' =
      IF(ISBLANK([Current Actions Count]) || [Current Actions Count] == 0,"No actions recorded",COALESCE([Current Action Status Label],"Multiple action states — see current actions"))

  measure 'Current Observation Display' =
      IF(ISBLANK([Current Observations Count]) || [Current Observations Count] == 0,"No outcomes recorded",COALESCE([Current Observation Kind Label],"Mixed observation kinds — see each series"))

  measure 'Projection Updated Display' =
      VAR V = [Projection Refresh Time] RETURN IF(ISBLANK(V), "Unavailable", FORMAT(V, "MMM d, yyyy HH:mm") & " UTC")

  measure 'Actions State' =
      IF(ISBLANK([Selected Case Key]),[Case Selection State],IF(ISBLANK([Current Decision Key]),"No current decision recorded","Current decision" & IF([Analysis Requested] == 1 && ISBLANK([Selected Analysis Key])," · Requested analysis unavailable; these are current-decision records",IF(NOT ISBLANK([Selected Analysis Key]) && [Selected Analysis Key] <> [Decision Analysis Key]," · Decision belongs to a different saved analysis from the one being viewed",""))))

  measure 'Action Explanation' =
      IF(NOT ISBLANK([Selected Case Key]),[Current Action Status Display] & ". " & [Current Observation Display] & ". Predictions and observations remain separate. Simulated observations are not real-world outcomes.")

  partition CaseCommandCenter = m
    mode: directQuery
    source =
        Sql.Database(FABRIC_SQL_SERVER, FABRIC_SQL_DATABASE, [Query="SELECT c.case_id,c.purpose,c.status,c.runtime_mode,#(lf) CAST(N'traditional' AS nvarchar(16)) AS walkthrough_route,#(lf) CONVERT(datetime2(6),SWITCHOFFSET(c.scenario_effective_time,'+00:00')) AS scenario_effective_time,#(lf) c.current_analysis_id,c.current_decision_id,#(lf) CONVERT(datetime2(6),SWITCHOFFSET(c.analysis_created_at,'+00:00')) AS analysis_created_at,c.snapshot_state,#(lf) c.recommended_option_id,c.baseline_option_id,c.decision_kind,c.decision_analysis_id,#(lf) CONVERT(datetime2(6),SWITCHOFFSET(c.decided_at,'+00:00')) AS decided_at,c.approved_option_id,#(lf) c.baseline_revenue_at_risk,c.baseline_otif_loss_percentage,#(lf) c.baseline_uncovered_part_demand,c.baseline_response_cost,#(lf) c.recommended_revenue_at_risk,c.recommended_otif_loss_percentage,#(lf) c.recommended_uncovered_part_demand,c.recommended_response_cost,#(lf) c.approved_revenue_at_risk,c.approved_otif_loss_percentage,#(lf) c.approved_uncovered_part_demand,c.approved_response_cost,#(lf) CONVERT(varchar(max),CONVERT(varbinary(max),CONVERT(nvarchar(max),c.case_id)),2) AS case_key,#(lf) CONVERT(varchar(max),CONVERT(varbinary(max),CONVERT(nvarchar(max),c.current_analysis_id)),2) AS current_analysis_key,#(lf) CONVERT(varchar(max),CONVERT(varbinary(max),CONVERT(nvarchar(max),c.current_decision_id)),2) AS current_decision_key,#(lf) CONVERT(varchar(max),CONVERT(varbinary(max),CONVERT(nvarchar(max),c.decision_analysis_id)),2) AS decision_analysis_key,#(lf) CONVERT(varchar(max),CONVERT(varbinary(max),CONVERT(nvarchar(max),c.approved_option_id)),2) AS approved_option_key#(lf)FROM analytics.case_reporting c#(lf)"])
