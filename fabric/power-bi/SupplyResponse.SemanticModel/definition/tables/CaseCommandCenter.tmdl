      VAR ScopeAnalysis = [Selected Analysis Key]
      RETURN IF(NOT ISBLANK(ScopeCase) && NOT ISBLANK(ScopeAnalysis), CALCULATE(SELECTEDVALUE(SavedOptions[revenue_at_risk]), REMOVEFILTERS(SavedOptions), KEEPFILTERS(TREATAS({ScopeCase}, SavedOptions[case_key])), KEEPFILTERS(TREATAS({ScopeAnalysis}, SavedOptions[analysis_key])), KEEPFILTERS(TREATAS({[Selected Option Key]}, SavedOptions[option_key]))))))
    isHidden

  measure 'Selected Option response_cost' =
      IF(NOT ISBLANK([Selected Option Key]),(VAR ScopeCase = [Selected Case Key]
      VAR ScopeAnalysis = [Selected Analysis Key]
      RETURN IF(NOT ISBLANK(ScopeCase) && NOT ISBLANK(ScopeAnalysis), CALCULATE(SELECTEDVALUE(SavedOptions[response_cost]), REMOVEFILTERS(SavedOptions), KEEPFILTERS(TREATAS({ScopeCase}, SavedOptions[case_key])), KEEPFILTERS(TREATAS({ScopeAnalysis}, SavedOptions[analysis_key])), KEEPFILTERS(TREATAS({[Selected Option Key]}, SavedOptions[option_key]))))))
    isHidden

  measure 'Selected Option blockers_text' =
      IF(NOT ISBLANK([Selected Option Key]),(VAR ScopeCase = [Selected Case Key]
      VAR ScopeAnalysis = [Selected Analysis Key]
      RETURN IF(NOT ISBLANK(ScopeCase) && NOT ISBLANK(ScopeAnalysis), CALCULATE(SELECTEDVALUE(SavedOptions[blockers_text]), REMOVEFILTERS(SavedOptions), KEEPFILTERS(TREATAS({ScopeCase}, SavedOptions[case_key])), KEEPFILTERS(TREATAS({ScopeAnalysis}, SavedOptions[analysis_key])), KEEPFILTERS(TREATAS({[Selected Option Key]}, SavedOptions[option_key]))))))
    isHidden

  measure 'Selected Option required_roles_text' =
      IF(NOT ISBLANK([Selected Option Key]),(VAR ScopeCase = [Selected Case Key]
      VAR ScopeAnalysis = [Selected Analysis Key]
      RETURN IF(NOT ISBLANK(ScopeCase) && NOT ISBLANK(ScopeAnalysis), CALCULATE(SELECTEDVALUE(SavedOptions[required_roles_text]), REMOVEFILTERS(SavedOptions), KEEPFILTERS(TREATAS({ScopeCase}, SavedOptions[case_key])), KEEPFILTERS(TREATAS({ScopeAnalysis}, SavedOptions[analysis_key])), KEEPFILTERS(TREATAS({[Selected Option Key]}, SavedOptions[option_key]))))))
    isHidden

  measure 'Selected Option assumptions_text' =
      IF(NOT ISBLANK([Selected Option Key]),(VAR ScopeCase = [Selected Case Key]
      VAR ScopeAnalysis = [Selected Analysis Key]
      RETURN IF(NOT ISBLANK(ScopeCase) && NOT ISBLANK(ScopeAnalysis), CALCULATE(SELECTEDVALUE(SavedOptions[assumptions_text]), REMOVEFILTERS(SavedOptions), KEEPFILTERS(TREATAS({ScopeCase}, SavedOptions[case_key])), KEEPFILTERS(TREATAS({ScopeAnalysis}, SavedOptions[analysis_key])), KEEPFILTERS(TREATAS({[Selected Option Key]}, SavedOptions[option_key]))))))
    isHidden

  measure 'Options State' =
      IF(ISBLANK([Selected Case Key]),[Case Selection State],IF(ISBLANK([Selected Analysis Key]),"Saved analysis or operational snapshot unavailable",IF([Option Requested] == 1 && ISBLANK([Selected Option Key]),"Selected option unavailable",[Snapshot Context])))

  measure 'Selected Option Display' =
      IF([Option Requested] == 0,"Compare the saved options",IF(ISBLANK([Selected Option Key]),"Selected option unavailable",[Selected Option option_display_name]))

  measure 'Option Revenue Display' =
      VAR V = [Selected Option revenue_at_risk] RETURN IF(ISBLANK(V), "Unavailable", FORMAT(V, "#,0.##") & "; currency not specified")

  measure 'Option Cost Display' =
      VAR V = [Selected Option response_cost] RETURN IF(ISBLANK(V), "Unavailable", FORMAT(V, "#,0.##") & "; currency not specified")

  measure 'Options Explanation' =
      IF(NOT ISBLANK([Selected Analysis Key]),IF([Option Requested] == 0,"Compare expected cost, service exposure, parts still needed, and whether each option meets the planning requirements. These predictions are not approved actions or outcomes.",IF(NOT ISBLANK([Selected Option Key]),COALESCE([Selected Option blockers_text],"Planning blockers unavailable") & ". " & COALESCE([Selected Option required_roles_text],"Required roles unavailable"))))

  measure 'Baseline option_display_name' =
      VAR ScopeCase = [Selected Case Key]
      VAR ScopeAnalysis = [Overview Analysis Key]
      RETURN IF(NOT ISBLANK(ScopeCase) && NOT ISBLANK(ScopeAnalysis), CALCULATE(IF(COUNTROWS(SavedOptions) == 1,CONCATENATEX(SavedOptions,SavedOptions[option_display_name],"")), REMOVEFILTERS(SavedOptions), KEEPFILTERS(TREATAS({ScopeCase}, SavedOptions[case_key])), KEEPFILTERS(TREATAS({ScopeAnalysis}, SavedOptions[analysis_key])), KEEPFILTERS(SavedOptions[is_baseline] == TRUE())))
