      RETURN IF(NOT ISBLANK(ScopeCase) && NOT ISBLANK(ScopeAnalysis), CALCULATE(SELECTEDVALUE(SavedRecords[source_timestamp]), REMOVEFILTERS(SavedRecords), KEEPFILTERS(TREATAS({ScopeCase}, SavedRecords[case_key])), KEEPFILTERS(TREATAS({ScopeAnalysis}, SavedRecords[analysis_key])), KEEPFILTERS(TREATAS({[Selected Record Key]}, SavedRecords[record_key])), KEEPFILTERS(TREATAS({[Selected Record Family]}, SavedRecords[record_family])), KEEPFILTERS(SavedRecords[record_state] == "available"), KEEPFILTERS(SavedRecords[evidence_state] == "available")))))
    isHidden

  measure 'Record Row Visible' =
      IF(NOT ISBLANK([Selected Record Key]), INT((VAR ScopeCase = [Selected Case Key]
      VAR ScopeAnalysis = [Selected Analysis Key]
      RETURN IF(NOT ISBLANK(ScopeCase) && NOT ISBLANK(ScopeAnalysis), CALCULATE(COUNTROWS(SavedRecords), KEEPFILTERS(TREATAS({ScopeCase}, SavedRecords[case_key])), KEEPFILTERS(TREATAS({ScopeAnalysis}, SavedRecords[analysis_key])), KEEPFILTERS(TREATAS({[Selected Record Key]}, SavedRecords[record_key])), KEEPFILTERS(TREATAS({[Selected Record Family]}, SavedRecords[record_family])), KEEPFILTERS(SavedRecords[record_state] == "available"), KEEPFILTERS(SavedRecords[evidence_state] == "available")))) > 0),0)
    isHidden

  measure 'Record Supplier' =
      VAR V = [Record supplier_id] RETURN IF(ISBLANK(V),"Supplier unavailable",SWITCH(TRUE(),EXACT(V,"RL-SUP-ALPHA"),"RL-Supplier Alpha — Current supplier",EXACT(V,"RL-SUP-BETA"),"RL-Supplier Beta — Alternate supplier","Supplier " & V))
    isHidden

  measure 'Record Source Plant' =
      VAR V = [Record source_plant_id] RETURN IF(ISBLANK(V),"Plant unavailable",SWITCH(TRUE(),EXACT(V,"RL-PLANT-DAL"),"Dallas plant",EXACT(V,"RL-PLANT-CHI"),"Chicago plant","Plant " & V))
    isHidden

  measure 'Record Destination Plant' =
      VAR V = [Record destination_plant_id] RETURN IF(ISBLANK(V),"Plant unavailable",SWITCH(TRUE(),EXACT(V,"RL-PLANT-DAL"),"Dallas plant",EXACT(V,"RL-PLANT-CHI"),"Chicago plant","Plant " & V))
    isHidden

  measure 'Record Qualification' =
      VAR V = [Record status] RETURN SWITCH(TRUE(),ISBLANK(V),"Qualification unavailable",EXACT(V,"approved"),"Qualification approved",EXACT(V,"pending"),"Not yet qualified — review pending",EXACT(V,"not_approved"),"Qualification not approved",EXACT(V,"conditional"),"Conditional qualification — requirements remain","Qualification status unresolved (" & V & ")")
    isHidden

  measure 'Record Provenance Display' =
      IF(NOT ISBLANK([Selected Record Key]),SWITCH([Record provenance],
              "saved_fabric","Saved Microsoft Fabric record · fictional scenario",
              "demo_fixture","Saved demo fixture · fictional",
              "Saved record · provenance unavailable") & " · Retrieved for this analysis: "
              & IF(ISBLANK([Record retrieved_at]),"Unavailable",FORMAT([Record retrieved_at],"MMM d, yyyy HH:mm") & " UTC"))
    isHidden

  measure 'Record State' =
      IF(ISBLANK([Selected Record Key]),"Supporting record unavailable — select the exact case, analysis and record",
              SWITCH([Selected Record Family],"shipment",[Record Supplier] & " · Partial shipment",
              "qualification",[Record Supplier] & " · Qualification",
              "transfer",[Record Source Plant] & " to " & [Record Destination Plant])
              & " · " & [Record Provenance Display])

  measure 'Record Quantity Display' =
      VAR V = [Record quantity] RETURN IF(ISBLANK(V), "Unavailable", FORMAT(V, "#,0") & " component units")

  measure 'Record Due Date Display' =
      VAR V = [Record due_date] RETURN IF(ISBLANK(V), "Unavailable", FORMAT(V, "MMM d, yyyy") & "")

  measure 'Record Arrival Date Display' =
      VAR V = [Record arrival_date] RETURN IF(ISBLANK(V), "Unavailable", FORMAT(V, "MMM d, yyyy") & "")

  measure 'Record Unit Cost Display' =
      VAR V = [Record incremental_cost_per_unit] RETURN IF(ISBLANK(V), "Unavailable", FORMAT(V, "#,0.00") & " per unit; currency not specified")

  measure 'Record Status Display' =
      VAR V = [Record Qualification] RETURN IF(ISBLANK(V), "Unavailable", V)

  measure 'Record Audit Display' =
      VAR V = [Record audit_complete] RETURN IF(ISBLANK(V),"Unavailable",IF(V,"Complete","Outstanding"))

  measure 'Record First Article Display' =
      VAR V = [Record first_article_complete] RETURN IF(ISBLANK(V),"Unavailable",IF(V,"Complete","Outstanding"))

  measure 'Record Explanation' =
      IF(NOT ISBLANK([Selected Record Key]),SWITCH([Selected Record Family],
              "shipment","This proposed shipment is a response option under review. The quantity, date, and cost above come from the shipment record; the supplier statement remains in the original supplier email. It is not approved or delivered.",
              "transfer","This planned transfer could move stock between the plants shown above. Its dispatch, arrival, and cost are not approval or proof of completion.",
              "qualification","Audit: " & [Record Audit Display] & "; first article: " & [Record First Article Display]
                  & ". Review date: " & IF(ISBLANK([Record expected_decision_date]),"Unavailable",FORMAT([Record expected_decision_date],"MMM d, yyyy"))
                  & ". A review date is not an approval or delivery date."))

  measure 'Stock Rows Valid' =
      IF([Selected inventory_complete] == TRUE(),(VAR ScopeCase = [Selected Case Key]
      VAR ScopeAnalysis = [Selected Analysis Key]
      RETURN IF(NOT ISBLANK(ScopeCase) && NOT ISBLANK(ScopeAnalysis), CALCULATE(IF(COUNTROWS(SavedRecords)>0 && COALESCE(COUNTROWS(FILTER(SavedRecords,SavedRecords[record_state] <> "available")),0) == 0,1,0), REMOVEFILTERS(SavedRecords), KEEPFILTERS(TREATAS({ScopeCase}, SavedRecords[case_key])), KEEPFILTERS(TREATAS({ScopeAnalysis}, SavedRecords[analysis_key])), KEEPFILTERS(SavedRecords[record_family] == "inventory")))),0)
    isHidden

  measure 'Stock Row Visible' =
      IF([Stock Rows Valid] == 1,INT((VAR ScopeCase = [Selected Case Key]
      VAR ScopeAnalysis = [Selected Analysis Key]
      RETURN IF(NOT ISBLANK(ScopeCase) && NOT ISBLANK(ScopeAnalysis), CALCULATE(COUNTROWS(SavedRecords), KEEPFILTERS(TREATAS({ScopeCase}, SavedRecords[case_key])), KEEPFILTERS(TREATAS({ScopeAnalysis}, SavedRecords[analysis_key])), KEEPFILTERS(SavedRecords[record_family] == "inventory"), KEEPFILTERS(SavedRecords[in_disruption_scope] == TRUE()), KEEPFILTERS(SavedRecords[record_state] == "available")))) > 0),0)
    isHidden

  measure 'Stock Count' =
      IF([Stock Rows Valid] == 1,(VAR ScopeCase = [Selected Case Key]
      VAR ScopeAnalysis = [Selected Analysis Key]
