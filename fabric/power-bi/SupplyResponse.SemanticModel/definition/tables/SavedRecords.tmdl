    sourceColumn: analysis_id
    summarizeBy: none

  column record_family
    dataType: string
    sourceColumn: record_family
    summarizeBy: none

  column source_record_id
    dataType: string
    sourceColumn: source_record_id
    summarizeBy: none

  column runtime_mode
