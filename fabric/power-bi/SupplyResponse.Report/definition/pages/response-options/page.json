{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/page/2.0.0/schema.json",
  "name": "response-options",
  "displayName": "Response options",
  "displayOption": "FitToPage",
  "width": 1280,
  "height": 720,
  "objects": {
    "background": [
      {
        "properties": {
          "color": {
            "solid": {
              "color": {
                "expr": {
                  "Literal": {
                    "Value": "'#F5F3EA'"
                  }
                }
              }
            }
          },
          "transparency": {
            "expr": {
              "Literal": {
                "Value": "0D"
              }
            }
          }
        }
      }
    ],
    "pageRefresh": [
      {
        "properties": {
          "show": true,
          "refreshType": "FixedInterval",
          "duration": 30
        }
      }
    ]
  }
}
