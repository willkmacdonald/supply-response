# Supply Response local environment.
# Copy to .env and adjust. Never commit real secrets or tenant credentials.

# ---------------------------------------------------------------------------
# Backend (FastAPI)
# ---------------------------------------------------------------------------
# SQLAlchemy URL for application state. SQLite is the local default.
SUPPLY_RESPONSE_DB_URL=sqlite:///./supply_response.db

# Seed for the deterministic synthetic dataset.
SUPPLY_RESPONSE_SEED=42

# Optional: load a pre-generated dataset instead of generating one at startup.
# SUPPLY_RESPONSE_DATASET=data/synthetic/dataset.json

# Comma-separated CORS origins allowed to call the API.
SUPPLY_RESPONSE_CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# Frontend (Vite) - see apps/web/.env.example
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Optional hosted services. Leave blank for local development.
# The local stack never calls Azure, Fabric, Foundry, or Work IQ.
# Use managed identity where available; never put credentials in frontend code.
# ---------------------------------------------------------------------------
# FABRIC_SQL_ENDPOINT=
# FABRIC_WORKSPACE_ID=
# FABRIC_LAKEHOUSE_ID=
# FOUNDRY_PROJECT_ENDPOINT=
# FOUNDRY_AGENT_ID=
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
# AZURE_OPENAI_API_KEY=          # leave blank when using managed identity
# AZURE_OPENAI_API_VERSION=2024-08-01-preview
# AZURE_OPENAI_SIGNAL_DEPLOYMENT=gpt-4o   # model deployment for the Signal agent
# AZURE_OPENAI_DECISION_DEPLOYMENT=gpt-4o # model deployment for the Decision agent
# WORK_IQ_ENDPOINT=
# POWER_BI_REPORT_URL=
